<UserControl x:Class="NarutoLauncher.Views.GamesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:views="clr-namespace:NarutoLauncher.Views">
    <Grid Margin="24" Background="{DynamicResource AppBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="游戏" FontSize="22" FontWeight="Bold"
                   Foreground="{DynamicResource AppForeground}" Margin="0,0,0,12"/>

        <!-- 内嵌游戏窗口（保持深色背景） -->
        <Border Grid.Row="1" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1"
                CornerRadius="8" Background="#1E1E1E" ClipToBounds="True">
            <Grid>
                <StackPanel x:Name="Placeholder" HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <TextBlock Text="游戏窗口将显示在这里" FontSize="15" Foreground="#999"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="选择账号后点击下方「开始游戏」" FontSize="12" Foreground="#777"
                               HorizontalAlignment="Center" Margin="0,6,0,0"/>
                </StackPanel>
                <views:GameHostView x:Name="GameHost" Visibility="Collapsed"/>
            </Grid>
        </Border>

        <!-- 操作区 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,0" HorizontalAlignment="Left">
            <hc:ComboBox x:Name="AccountSelector" Width="220" Margin="0,0,12,0"
                         VerticalContentAlignment="Center"/>
            <Button x:Name="StartBtn" Content="开始游戏（内嵌）" Style="{StaticResource ButtonPrimary}"
                    Width="150" Height="34" Margin="0,0,8,0" Click="OnStartGame"/>
            <Button x:Name="StopBtn" Content="停止游戏" Width="110" Height="34" Click="OnStopGame"/>
        </StackPanel>
    </Grid>
</UserControl>
