<UserControl x:Class="NarutoLauncher.Views.AccountsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="20">
        <TextBlock DockPanel.Dock="Top" Text="账号管理" FontSize="20" FontWeight="Bold"
                   Foreground="#2B2118" Margin="0,0,0,8"/>
        <TextBlock DockPanel.Dock="Top" x:Name="CountText" Foreground="#8A7A66"
                   FontSize="12" Margin="0,0,0,12"/>
        <Button DockPanel.Dock="Bottom" Content="添加账号" Padding="16,6"
                HorizontalAlignment="Left" Margin="0,12,0,0" Click="OnAddAccount"
                Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}"/>

        <ListView x:Name="AccountList">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="36" Height="36" CornerRadius="18"
                                Background="#E8482C" Margin="0,0,10,0">
                            <TextBlock Text="{Binding AvatarChar}" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding InfoText}" Foreground="#8A7A66" FontSize="12"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="删除" Margin="0,0,6,0" Padding="10,3"
                                    Click="OnDeleteAccount" Tag="{Binding Id}"/>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </DockPanel>
</UserControl>
