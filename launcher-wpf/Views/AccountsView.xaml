<UserControl x:Class="NarutoLauncher.Views.AccountsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hc="https://handyorg.github.io/handycontrol">
    <Grid Margin="24" Background="{DynamicResource AppBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="账号管理" FontSize="22" FontWeight="Bold"
                   Foreground="{DynamicResource AppForeground}" Margin="0,0,0,8"/>
        <TextBlock Grid.Row="1" x:Name="CountText"
                   Foreground="{DynamicResource AppForegroundSecondary}"
                   FontSize="12" Margin="0,0,0,12"/>

        <!-- 账号列表 -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="AccountList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="{DynamicResource CardBorder}" BorderThickness="1"
                                CornerRadius="8" Background="{DynamicResource RowBackground}"
                                Padding="16,12" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="42" Height="42" CornerRadius="21"
                                        Background="{DynamicResource AccentBrush}" Margin="0,0,12,0">
                                    <TextBlock Text="{Binding AvatarChar}" Foreground="White"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               FontSize="16" FontWeight="Bold"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"
                                               Foreground="{DynamicResource AppForeground}" FontSize="14"/>
                                    <TextBlock Text="{Binding InfoText}"
                                               Foreground="{DynamicResource AppForegroundSecondary}"
                                               FontSize="12" Margin="0,2,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <Button Content="删除" Style="{StaticResource ButtonDanger}"
                                            Width="70" Height="30" Margin="0,0,6,0"
                                            Click="OnDeleteAccount" Tag="{Binding Id}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Button Grid.Row="3" Content="添加账号" Style="{StaticResource ButtonPrimary}"
                Width="130" Height="34" HorizontalAlignment="Left" Margin="0,12,0,0"
                Click="OnAddAccount"/>
    </Grid>
</UserControl>
