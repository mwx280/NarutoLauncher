<hc:Window x:Class="NarutoLauncher.Views.AddAccountWindow"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:hc="https://handyorg.github.io/handycontrol"
           Title="添加账号" Height="560" Width="480"
           WindowStartupLocation="CenterOwner"
           Background="{DynamicResource AppBackground}"
           ResizeMode="NoResize">
    <hc:Window.Resources>
        <!-- 输入框样式（适配深色/浅色） -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource InputBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppForeground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorder}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource AppForeground}"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="{DynamicResource InputBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppForeground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorder}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource AppForeground}"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <!-- 选项卡样式：标题居中 + 深色适配 -->
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}"/>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource AppForeground}"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <!-- 普通按钮 -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource RowBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppForeground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}"/>
        </Style>
    </hc:Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 选项卡：账号密码 / 扫码登录（标题居中） -->
        <TabControl Grid.Row="0" x:Name="MainTabs"
                    HorizontalAlignment="Stretch">
            <TabControl.Resources>
                <!-- 让 Tab 标题居中均分 -->
                <Style TargetType="TabItem">
                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                    <Setter Property="Padding" Value="0,8"/>
                    <Setter Property="Width" Value="210"/>
                    <Setter Property="HeaderTemplate">
                        <Setter.Value>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontSize="14"
                                           Foreground="{DynamicResource AppForeground}"
                                           HorizontalAlignment="Center" TextAlignment="Center"/>
                            </DataTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.Resources>

            <!-- 账号密码 -->
            <TabItem Header="账号密码">
                <StackPanel Margin="0,20,0,4">
                    <TextBlock Text="QQ 号" FontSize="13"
                               Foreground="{DynamicResource AppForeground}"
                               HorizontalAlignment="Center" Margin="0,0,0,6"/>
                    <TextBox x:Name="QqBox" Height="36" FontSize="14" Width="320"
                             HorizontalAlignment="Center"/>

                    <TextBlock Text="密码" FontSize="13"
                               Foreground="{DynamicResource AppForeground}"
                               HorizontalAlignment="Center" Margin="0,16,0,6"/>
                    <PasswordBox x:Name="PwdBox" Height="36" FontSize="14" Width="320"
                                 HorizontalAlignment="Center"/>

                    <CheckBox x:Name="RememberPwdBox" Content="记住密码（本地加密存储）"
                              Margin="0,14,0,0" FontSize="13"
                              Foreground="{DynamicResource AppForeground}" IsChecked="True"
                              HorizontalAlignment="Center"/>

                    <TextBlock Text="备注（可选）" FontSize="13"
                               Foreground="{DynamicResource AppForeground}"
                               HorizontalAlignment="Center" Margin="0,20,0,6"/>
                    <TextBox x:Name="NameBox" Height="36" FontSize="14" Width="320"
                             HorizontalAlignment="Center"/>

                    <TextBlock Text="添加后可点击账号「开始游戏」进入游戏，登录状态将自动保存"
                               FontSize="12" Foreground="{DynamicResource AppForegroundSecondary}"
                               TextWrapping="Wrap" Margin="0,20,0,0" HorizontalAlignment="Center"/>
                </StackPanel>
            </TabItem>

            <!-- 扫码登录 -->
            <TabItem Header="扫码登录">
                <StackPanel Margin="0,20,0,4">
                    <TextBlock Text="使用手机 QQ 扫描二维码登录" FontSize="14"
                               Foreground="{DynamicResource AppForeground}"
                               HorizontalAlignment="Center" Margin="0,0,0,12"/>

                    <Border Background="{DynamicResource RowBackground}" CornerRadius="8"
                            Height="210" HorizontalAlignment="Center" Width="210">
                        <Grid>
                            <StackPanel x:Name="QrPlaceholder" VerticalAlignment="Center">
                                <TextBlock Text="二维码加载中..." FontSize="13"
                                           Foreground="{DynamicResource AppForegroundSecondary}"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                            <Image x:Name="QrImage" Visibility="Collapsed"
                                   Stretch="Uniform" Margin="10"/>
                        </Grid>
                    </Border>

                    <Button x:Name="RefreshQrBtn" Content="刷新二维码" Width="130" Height="32"
                            HorizontalAlignment="Center" Margin="0,14,0,0"
                            Click="OnRefreshQr"/>

                    <TextBlock Text="备注（可选）" FontSize="13"
                               Foreground="{DynamicResource AppForeground}"
                               HorizontalAlignment="Center" Margin="0,20,0,6"/>
                    <TextBox x:Name="ScanNameBox" Height="36" FontSize="14" Width="320"
                             HorizontalAlignment="Center"/>

                    <TextBlock Text="登录后账号自动保存，Cookie 持久化，下次可直接开始游戏"
                               FontSize="12" Foreground="{DynamicResource AppForegroundSecondary}"
                               TextWrapping="Wrap" HorizontalAlignment="Center"
                               Margin="0,16,0,0"/>
                </StackPanel>
            </TabItem>
        </TabControl>

        <!-- 底部按钮 -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button Content="取消" Width="90" Height="34" Margin="0,0,10,0"
                    Click="OnCancel"/>
            <Button x:Name="ConfirmBtn" Content="添加账号" Style="{StaticResource ButtonPrimary}"
                    Width="110" Height="34" Click="OnConfirm"/>
        </StackPanel>
    </Grid>
</hc:Window>
