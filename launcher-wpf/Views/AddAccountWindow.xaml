<ui:FluentWindow x:Class="NarutoLauncher.Views.AddAccountWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="添加账号" Height="570" Width="460"
                 WindowStartupLocation="CenterOwner"
                 ResizeMode="NoResize"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 选项卡：账号密码 / 扫码登录 -->
        <TabControl Grid.Row="0" x:Name="MainTabs">
            <!-- 账号密码 -->
            <TabItem Header="账号密码">
                <StackPanel Margin="4,16,4,4">
                    <TextBlock Text="QQ 号" FontSize="13"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,4"/>
                    <ui:TextBox x:Name="QqBox" Height="34" FontSize="14"/>
                    <TextBlock Text="备注（可选）" FontSize="13"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,16,0,4"/>
                    <ui:TextBox x:Name="NameBox" Height="34" FontSize="14"/>
                    <TextBlock Text="密码" FontSize="13"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,16,0,4"/>
                    <ui:PasswordBox x:Name="PwdBox" Height="34" FontSize="14"/>
                    <CheckBox x:Name="RememberPwdBox" Content="记住密码（本地加密存储）"
                              Margin="0,12,0,0" FontSize="13" IsChecked="True"/>
                    <TextBlock Text="添加后可点击账号「开始游戏」进入游戏，登录状态将自动保存"
                               FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" Margin="0,16,0,0"/>
                </StackPanel>
            </TabItem>

            <!-- 扫码登录 -->
            <TabItem Header="扫码登录">
                <StackPanel Margin="4,16,4,4">
                    <Border Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="8"
                            Height="220" HorizontalAlignment="Center" Width="220"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                            BorderThickness="1">
                        <Grid>
                            <StackPanel x:Name="QrPlaceholder" VerticalAlignment="Center">
                                <TextBlock Text="二维码加载中..." FontSize="13"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                            <Image x:Name="QrImage" Visibility="Collapsed"
                                      Stretch="Uniform" Margin="10"/>
                        </Grid>
                    </Border>
                    <TextBlock Text="使用手机 QQ 扫描二维码登录" FontSize="13"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                               HorizontalAlignment="Center" Margin="0,12,0,0"/>
                    <TextBlock Text="登录后账号自动保存，下次可直接开始游戏（Cookie 已持久化）"
                               FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" HorizontalAlignment="Center"
                               Margin="0,6,0,0"/>
                    <ui:Button x:Name="RefreshQrBtn" Content="刷新二维码" Width="120" Height="32"
                               HorizontalAlignment="Center" Margin="0,14,0,0"
                               Appearance="Secondary" Click="OnRefreshQr"/>
                    <TextBlock Text="备注（可选）" FontSize="13"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,18,0,4"/>
                    <ui:TextBox x:Name="ScanNameBox" Height="34" FontSize="14"/>
                </StackPanel>
            </TabItem>
        </TabControl>

        <!-- 底部按钮 -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <ui:Button Content="取消" Appearance="Secondary" Width="90" Height="34"
                       Margin="0,0,10,0" Click="OnCancel"/>
            <ui:Button x:Name="ConfirmBtn" Content="添加账号" Appearance="Primary"
                       Width="110" Height="34" Click="OnConfirm"/>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
