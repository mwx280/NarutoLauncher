<hc:Window x:Class="NarutoLauncher.Views.AddAccountWindow"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:hc="https://handyorg.github.io/handycontrol"
           Title="添加账号" Height="570" Width="460"
           WindowStartupLocation="CenterOwner"
           Background="{DynamicResource AppBackground}"
           ResizeMode="NoResize">
    <hc:Window.Resources>
        <!-- 输入框样式（适配深色/浅色 + 内容垂直居中） -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource InputBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppForeground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorder}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource AppForeground}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="8,0"/>
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="{DynamicResource InputBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppForeground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorder}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource AppForeground}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="8,0"/>
        </Style>
        <!-- 选项卡样式：深色适配 + 选中/hover 高亮 -->
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppForeground}"/>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource AppForegroundSecondary}"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="HeaderTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" FontSize="14"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}"
                                   HorizontalAlignment="Center"/>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6"
                                Margin="2,0" Padding="{TemplateBinding Padding}"
                                BorderBrush="{DynamicResource CardBorder}" BorderThickness="1">
                            <ContentPresenter x:Name="Content" ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- hover -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource AccentFaint}"/>
                                <Setter Property="Foreground"
                                        Value="{DynamicResource AppForeground}"/>
                            </Trigger>
                            <!-- 选中：强调色高亮 + 白字 -->
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 普通按钮：圆角 + hover 深色适配 -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource RowBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppForeground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource IconBackground}"/>
                                <Setter TargetName="Bd" Property="BorderBrush"
                                        Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource CardBorder}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </hc:Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 选项卡：账号密码 / 扫码登录 -->
        <TabControl Grid.Row="0" x:Name="MainTabs">
            <!-- 账号密码 -->
            <TabItem Header="账号密码">
                <StackPanel Margin="4,16,4,4">
                    <TextBlock Text="QQ 号" FontSize="13"
                               Foreground="{DynamicResource AppForeground}" Margin="0,0,0,4"/>
                    <TextBox x:Name="QqBox" Height="34" FontSize="14"
                             Padding="8,0"/>
                    <TextBlock Text="备注（可选）" FontSize="13"
                               Foreground="{DynamicResource AppForeground}" Margin="0,16,0,4"/>
                    <TextBox x:Name="NameBox" Height="34" FontSize="14"
                             Padding="8,0"/>
                    <TextBlock Text="密码" FontSize="13"
                               Foreground="{DynamicResource AppForeground}" Margin="0,16,0,4"/>
                    <PasswordBox x:Name="PwdBox" Height="34" FontSize="14"
                                 Padding="8,0"/>
                    <CheckBox x:Name="RememberPwdBox" Content="记住密码（本地加密存储）"
                              Margin="0,12,0,0" FontSize="13"
                              Foreground="{DynamicResource AppForeground}" IsChecked="True"/>
                    <TextBlock Text="添加后可点击账号「开始游戏」进入游戏，登录状态将自动保存"
                               FontSize="12" Foreground="{DynamicResource AppForegroundSecondary}"
                               TextWrapping="Wrap" Margin="0,16,0,0"/>
                </StackPanel>
            </TabItem>

            <!-- 扫码登录 -->
            <TabItem Header="扫码登录">
                <StackPanel Margin="4,16,4,4">
                    <Border Background="{DynamicResource RowBackground}" CornerRadius="8"
                            Height="220" HorizontalAlignment="Center" Width="220">
                        <Grid>
                            <StackPanel x:Name="QrPlaceholder" VerticalAlignment="Center">
                                <TextBlock Text="二维码加载中..." FontSize="13"
                                           Foreground="{DynamicResource AppForegroundSecondary}"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                            <Image x:Name="QrImage" Visibility="Collapsed"
                                      Stretch="Uniform" Margin="10"/>
                        </Grid>
                    </Border>
                    <TextBlock Text="使用手机 QQ 扫描二维码登录" FontSize="13"
                               Foreground="{DynamicResource AppForeground}"
                               HorizontalAlignment="Center" Margin="0,12,0,0"/>
                    <TextBlock Text="登录后账号自动保存，下次可直接开始游戏（Cookie 已持久化）"
                               FontSize="12" Foreground="{DynamicResource AppForegroundSecondary}"
                               TextWrapping="Wrap" HorizontalAlignment="Center"
                               Margin="0,6,0,0"/>
                    <Button x:Name="RefreshQrBtn" Content="刷新二维码" Width="120" Height="32"
                            HorizontalAlignment="Center" Margin="0,14,0,0"
                            Click="OnRefreshQr"/>
                    <TextBlock Text="备注（可选）" FontSize="13"
                               Foreground="{DynamicResource AppForeground}" Margin="0,18,0,4"/>
                    <TextBox x:Name="ScanNameBox" Height="34" FontSize="14"
                             Padding="8,0"/>
                </StackPanel>
            </TabItem>
        </TabControl>

        <!-- 底部按钮 -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button Content="取消" Width="90" Height="34" Margin="0,0,10,0"
                    Click="OnCancel"/>
            <Button x:Name="ConfirmBtn" Content="添加账号" Style="{StaticResource ButtonPrimary}"
                    Width="110" Height="34" Click="OnConfirm"/>
        </StackPanel>
    </Grid>
</hc:Window>
