<hc:Window x:Class="NarutoLauncher.Views.NewsDetailWindow"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:hc="https://handyorg.github.io/handycontrol"
           xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
           Title="公告详情" Height="700" Width="900"
           WindowStartupLocation="CenterOwner"
           Background="{DynamicResource AppBackground}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource RowBackground}"
                BorderBrush="{DynamicResource CardBorder}" BorderThickness="0,0,0,1"
                Padding="16,12">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="关闭" Padding="14,4" Click="OnClose"
                        Background="{DynamicResource RowBackground}"
                        Foreground="{DynamicResource AppForeground}"
                        BorderBrush="{DynamicResource CardBorder}"/>
                <TextBlock x:Name="TitleText" FontSize="15" FontWeight="SemiBold"
                           Foreground="{DynamicResource AppForeground}"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <wv2:WebView2 Grid.Row="1" x:Name="Browser"
                      DefaultBackgroundColor="#1F1F1F"/>
    </Grid>
</hc:Window>
