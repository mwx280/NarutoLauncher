<hc:Window x:Class="NarutoLauncher.Views.NewsDetailWindow"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:hc="https://handyorg.github.io/handycontrol"
           Title="公告详情" Height="700" Width="900"
           WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#FAFAFA" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1"
                Padding="16,12">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="关闭" Padding="14,4" Click="OnClose"/>
                <TextBlock x:Name="TitleText" FontSize="15" FontWeight="SemiBold" Foreground="#333"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <WebBrowser Grid.Row="1" x:Name="Browser"/>
    </Grid>
</hc:Window>
