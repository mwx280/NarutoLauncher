<ui:FluentWindow x:Class="NarutoLauncher.Views.GameWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:views="clr-namespace:NarutoLauncher.Views"
                 Title="火影忍者OL"
                 Icon="/assets/favicon.png"
                 Height="800" Width="1200"
                 MinHeight="400" MinWidth="600"
                 WindowStartupLocation="CenterOwner"
                 WindowStyle="None"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round">
    <DockPanel>
        <!-- 标题栏：全屏 + 最小化/最大化/关闭 -->
        <ui:TitleBar x:Name="TitleBarHost" DockPanel.Dock="Top"
                     Title="{x:Null}"
                     Icon="{ui:ImageIcon '/assets/favicon.png'}"
                     ShowMaximize="True" ShowMinimize="True" ShowClose="True">
            <ui:TitleBar.TrailingContent>
                <Button x:Name="FullscreenBtn"
                        Width="44" Height="30" Padding="0"
                        VerticalAlignment="Top"
                        Background="Transparent"
                        ToolTip="全屏"
                        Click="OnToggleFullscreen">
                    <Button.Template>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Grid x:Name="LayoutRoot" Background="{TemplateBinding Background}">
                                <Viewbox Width="11" Height="11"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"
                                         Focusable="False"
                                         RenderOptions.BitmapScalingMode="HighQuality">
                                    <Canvas Width="72" Height="72" Focusable="False">
                                        <Path Data="M0,0 H28 L20,8 H8 V20 L0,28 Z M72,0 H44 L52,8 H64 V20 L72,28 Z M0,72 H28 L20,64 H8 V52 L0,44 Z M72,72 H44 L52,64 H64 V52 L72,44 Z"
                                              Fill="{Binding ButtonsForeground, RelativeSource={RelativeSource AncestorType={x:Type ui:TitleBar}}}"/>
                                    </Canvas>
                                </Viewbox>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="LayoutRoot" Property="Background"
                                            Value="{Binding ButtonsBackground, RelativeSource={RelativeSource AncestorType={x:Type ui:TitleBar}}}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </ui:TitleBar.TrailingContent>
        </ui:TitleBar>

        <!-- 内嵌游戏窗口区域（CEF GameHost 通过 HwndHost 嵌入） -->
        <Border Background="#1E1E1E" ClipToBounds="True">
            <Grid>
                <StackPanel x:Name="Placeholder" HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <TextBlock x:Name="PlaceholderText" Text="正在启动游戏…" FontSize="15" Foreground="#999"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="如果长时间无响应请关闭本窗口" FontSize="12" Foreground="#777"
                               HorizontalAlignment="Center" Margin="0,6,0,0"/>
                </StackPanel>
                <views:GameHostView x:Name="GameHost" Visibility="Collapsed"/>
            </Grid>
        </Border>
    </DockPanel>
</ui:FluentWindow>