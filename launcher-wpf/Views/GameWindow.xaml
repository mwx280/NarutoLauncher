<ui:FluentWindow x:Class="NarutoLauncher.Views.GameWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="火影忍者OL"
                 Height="800" Width="1200"
                 MinHeight="400" MinWidth="600"
                 WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round">
    <DockPanel>
        <!-- 标题栏：置顶 + 最小化/最大化/关闭 -->
        <ui:TitleBar x:Name="TitleBarHost" DockPanel.Dock="Top"
                     Title="火影忍者OL"
                     ShowMaximize="True" ShowMinimize="True" ShowClose="True">
            <ui:TitleBar.TrailingContent>
                <ui:Button x:Name="PinBtn" Appearance="Transparent"
                           ToolTip="置顶" Click="OnToggleTopmost"
                           Width="34" Height="30" Padding="0">
                    <TextBlock Text="📌" FontSize="13"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                </ui:Button>
            </ui:TitleBar.TrailingContent>
        </ui:TitleBar>

        <!-- 空白内容区（后续用于承载游戏画面） -->
        <Border Background="{DynamicResource WindowBackground}">
            <TextBlock Text="" FontSize="14"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
    </DockPanel>
</ui:FluentWindow>