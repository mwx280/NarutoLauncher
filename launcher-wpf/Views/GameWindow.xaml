<ui:FluentWindow x:Class="NarutoLauncher.Views.GameWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="火影忍者OL"
                 Height="800" Width="1200"
                 MinHeight="400" MinWidth="600"
                 WindowStartupLocation="CenterOwner"
                 WindowStyle="None"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round">
    <DockPanel>
        <!-- 标题栏：全屏 + 最小化/最大化/关闭 -->
        <ui:TitleBar x:Name="TitleBarHost" DockPanel.Dock="Top"
                     Title="{x:Null}"
                     ShowMaximize="True" ShowMinimize="True" ShowClose="True">
            <ui:TitleBar.TrailingContent>
                <Button x:Name="FullscreenBtn"
                        Width="44" Height="30" Padding="0"
                        ToolTip="全屏"
                        Click="OnToggleFullscreen">
                    <Button.Template>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Grid Background="{TemplateBinding Background}">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{Binding ButtonsBackground, RelativeSource={RelativeSource AncestorType={x:Type ui:TitleBar}}}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <ui:SymbolIcon Symbol="FullScreenMaximize20" FontSize="12"
                                   Foreground="{Binding ButtonsForeground, RelativeSource={RelativeSource AncestorType={x:Type ui:TitleBar}}}"/>
                </Button>
            </ui:TitleBar.TrailingContent>
        </ui:TitleBar>

        <!-- 空白内容区（后续用于承载游戏画面） -->
        <Border Background="{DynamicResource WindowBackground}">
            <TextBlock Text="" FontSize="14"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
    </DockPanel>
</ui:FluentWindow>