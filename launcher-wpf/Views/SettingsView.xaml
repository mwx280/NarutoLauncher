<UserControl x:Class="NarutoLauncher.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hc="https://handyorg.github.io/handycontrol">
    <ScrollViewer>
        <StackPanel Margin="24" MaxWidth="620" HorizontalAlignment="Left">
            <TextBlock Text="设置" FontSize="22" FontWeight="Bold" Foreground="#333"/>

            <hc:Card Margin="0,16,0,0" Padding="16">
                <StackPanel>
                    <TextBlock Text="游戏" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <CheckBox x:Name="GameSpeedBox" Content="游戏变速" Margin="0,4"/>
                    <CheckBox x:Name="AntiDropBox" Content="挂机防掉线" Margin="0,4"/>
                </StackPanel>
            </hc:Card>

            <hc:Card Margin="0,12,0,0" Padding="16">
                <StackPanel>
                    <TextBlock Text="自动化" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <CheckBox x:Name="AutoScriptBox" Content="自动脚本" Margin="0,4"/>
                    <CheckBox x:Name="AutoTaskBox" Content="自动任务" Margin="0,4"/>
                </StackPanel>
            </hc:Card>

            <hc:Card Margin="0,12,0,0" Padding="16">
                <StackPanel>
                    <TextBlock Text="界面" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <CheckBox x:Name="TrayBox" Content="最小化到托盘" Margin="0,4"/>
                </StackPanel>
            </hc:Card>

            <hc:Card Margin="0,12,0,0" Padding="16">
                <StackPanel>
                    <TextBlock Text="账号与安全" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <CheckBox x:Name="RememberPwdBox" Content="记住密码（本地 DPAPI 加密存储）" Margin="0,4"/>
                </StackPanel>
            </hc:Card>

            <hc:Card Margin="0,12,0,0" Padding="16">
                <StackPanel>
                    <TextBlock Text="关于" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <TextBlock Text="NarutoLauncher v0.1.0" Foreground="#333"/>
                    <TextBlock Text="火影忍者OL 启动器 · 多账号多开" Foreground="#8A7A66" Margin="0,2,0,0"/>
                </StackPanel>
            </hc:Card>
        </StackPanel>
    </ScrollViewer>
</UserControl>
