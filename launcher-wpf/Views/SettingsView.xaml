<UserControl x:Class="NarutoLauncher.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hc="https://handyorg.github.io/handycontrol">
    <UserControl.Resources>
        <!-- 设置卡片样式 -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E8E8E8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="20,16"/>
        </Style>
        <!-- 设置项行 -->
        <Style x:Key="ItemRowStyle" TargetType="Grid">
            <Setter Property="Margin" Value="0,6"/>
        </Style>

        <!-- 开关样式（滑轨 + 滑块） -->
        <Style x:Key="SwitchStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid>
                            <Border x:Name="Track" Background="#D0D0D0" CornerRadius="12"/>
                            <Ellipse x:Name="Thumb" Width="18" Height="18" Fill="White"
                                     HorizontalAlignment="Left" Margin="3,0,0,0"
                                     VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#E8482C"/>
                                <Setter TargetName="Thumb" Property="Margin" Value="23,0,0,0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer>
        <StackPanel Margin="28,24,28,24" MaxWidth="640" HorizontalAlignment="Left">

            <TextBlock Text="设置" FontSize="22" FontWeight="Bold" Foreground="#333"/>

            <!-- 游戏 -->
            <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="游戏" FontSize="15" FontWeight="SemiBold" Foreground="#E8482C"
                               Margin="0,0,0,6"/>
                    <Grid Style="{StaticResource ItemRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="游戏变速" FontSize="14" Foreground="#333"/>
                            <TextBlock Text="调整游戏运行速度" FontSize="12" Foreground="#999"/>
                        </StackPanel>
                        <ToggleButton Grid.Column="1" x:Name="GameSpeedBox" Style="{StaticResource SwitchStyle}"
                                      VerticalAlignment="Center"/>
                    </Grid>
                    <Grid Style="{StaticResource ItemRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="挂机防掉线" FontSize="14" Foreground="#333"/>
                            <TextBlock Text="挂机时自动重连，防止掉线" FontSize="12" Foreground="#999"/>
                        </StackPanel>
                        <ToggleButton Grid.Column="1" x:Name="AntiDropBox" Style="{StaticResource SwitchStyle}"
                                      VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 自动化 -->
            <Border Style="{StaticResource CardStyle}" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="自动化" FontSize="15" FontWeight="SemiBold" Foreground="#E8482C"
                               Margin="0,0,0,6"/>
                    <Grid Style="{StaticResource ItemRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="自动脚本" FontSize="14" Foreground="#333"/>
                            <TextBlock Text="自动执行预设脚本任务" FontSize="12" Foreground="#999"/>
                        </StackPanel>
                        <ToggleButton Grid.Column="1" x:Name="AutoScriptBox" Style="{StaticResource SwitchStyle}"
                                      VerticalAlignment="Center"/>
                    </Grid>
                    <Grid Style="{StaticResource ItemRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="自动任务" FontSize="14" Foreground="#333"/>
                            <TextBlock Text="自动完成日常任务" FontSize="12" Foreground="#999"/>
                        </StackPanel>
                        <ToggleButton Grid.Column="1" x:Name="AutoTaskBox" Style="{StaticResource SwitchStyle}"
                                      VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 界面 -->
            <Border Style="{StaticResource CardStyle}" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="界面" FontSize="15" FontWeight="SemiBold" Foreground="#E8482C"
                               Margin="0,0,0,6"/>
                    <Grid Style="{StaticResource ItemRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="最小化到托盘" FontSize="14" Foreground="#333"/>
                            <TextBlock Text="关闭窗口时最小化到系统托盘" FontSize="12" Foreground="#999"/>
                        </StackPanel>
                        <ToggleButton Grid.Column="1" x:Name="TrayBox" Style="{StaticResource SwitchStyle}"
                                      VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 账号与安全 -->
            <Border Style="{StaticResource CardStyle}" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="账号与安全" FontSize="15" FontWeight="SemiBold" Foreground="#E8482C"
                               Margin="0,0,0,6"/>
                    <Grid Style="{StaticResource ItemRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="记住密码" FontSize="14" Foreground="#333"/>
                            <TextBlock Text="本地 DPAPI 加密存储，安全保存账号密码" FontSize="12" Foreground="#999"/>
                        </StackPanel>
                        <ToggleButton Grid.Column="1" x:Name="RememberPwdBox" Style="{StaticResource SwitchStyle}"
                                      VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 关于 -->
            <Border Style="{StaticResource CardStyle}" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="关于" FontSize="15" FontWeight="SemiBold" Foreground="#E8482C"
                               Margin="0,0,0,6"/>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="40" Height="40" CornerRadius="20" Background="#E8482C"
                                Margin="0,0,12,0">
                            <TextBlock Text="忍" Foreground="White" FontSize="16" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="NarutoLauncher v0.1.0" FontSize="14" FontWeight="SemiBold"
                                       Foreground="#333"/>
                            <TextBlock Text="火影忍者OL 启动器 · 多账号多开" FontSize="12" Foreground="#999"
                                       Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>



