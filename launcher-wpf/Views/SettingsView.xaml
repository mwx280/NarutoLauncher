<UserControl x:Class="NarutoLauncher.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hc="https://handyorg.github.io/handycontrol">
    <UserControl.Resources>
        <!-- 开关样式（滑轨 + 滑块） -->
        <Style x:Key="SwitchStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid>
                            <Border x:Name="Track" Background="#C8C8C8" CornerRadius="10"/>
                            <Ellipse x:Name="Thumb" Width="14" Height="14" Fill="White"
                                     HorizontalAlignment="Left" Margin="3,0,0,0"
                                     VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#0078D4"/>
                                <Setter TargetName="Thumb" Property="Margin" Value="23,0,0,0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Win11 设置项行：图标 + 名称/说明 + 开关 -->
        <Style x:Key="SettingRowStyle" TargetType="Border">
            <Setter Property="Padding" Value="20,14"/>
            <Setter Property="Background" Value="#F5F5F5"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Margin" Value="0,3"/>
        </Style>

        <!-- 设置项图标 -->
        <Style x:Key="SettingIconStyle" TargetType="Border">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Background" Value="#E8E8E8"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Margin" Value="0,0,14,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer>
        <StackPanel Margin="28,20,28,24" MaxWidth="680" HorizontalAlignment="Left">

            <TextBlock Text="设置" FontSize="24" FontWeight="SemiBold" Foreground="#1A1A1A"
                       Margin="0,0,0,4"/>
            <TextBlock Text="Windows 11 设置风格" FontSize="13" Foreground="#666"
                       Margin="0,0,0,16"/>

            <!-- 游戏分组 -->
            <TextBlock Text="游戏" FontSize="14" FontWeight="SemiBold" Foreground="#333"
                       Margin="4,8,0,4"/>

            <!-- 游戏变速 -->
            <Border Style="{StaticResource SettingRowStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource SettingIconStyle}">
                        <TextBlock Text="&#xE94A;" FontFamily="Segoe Fluent Icons"
                                   FontSize="15" Foreground="#0078D4"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="游戏变速" FontSize="14" FontWeight="Medium" Foreground="#1A1A1A"/>
                        <TextBlock Text="调整游戏运行速度" FontSize="12" Foreground="#666"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                    <ToggleButton Grid.Column="2" x:Name="GameSpeedBox"
                                  Style="{StaticResource SwitchStyle}"/>
                </Grid>
            </Border>

            <!-- 挂机防掉线 -->
            <Border Style="{StaticResource SettingRowStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource SettingIconStyle}">
                        <TextBlock Text="&#xEA18;" FontFamily="Segoe Fluent Icons"
                                   FontSize="15" Foreground="#0078D4"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="挂机防掉线" FontSize="14" FontWeight="Medium" Foreground="#1A1A1A"/>
                        <TextBlock Text="挂机时自动重连，防止掉线" FontSize="12" Foreground="#666"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                    <ToggleButton Grid.Column="2" x:Name="AntiDropBox"
                                  Style="{StaticResource SwitchStyle}"/>
                </Grid>
            </Border>

            <!-- 自动化分组 -->
            <TextBlock Text="自动化" FontSize="14" FontWeight="SemiBold" Foreground="#333"
                       Margin="4,12,0,4"/>

            <!-- 自动脚本 -->
            <Border Style="{StaticResource SettingRowStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource SettingIconStyle}">
                        <TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons"
                                   FontSize="15" Foreground="#0078D4"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="自动脚本" FontSize="14" FontWeight="Medium" Foreground="#1A1A1A"/>
                        <TextBlock Text="自动执行预设脚本任务" FontSize="12" Foreground="#666"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                    <ToggleButton Grid.Column="2" x:Name="AutoScriptBox"
                                  Style="{StaticResource SwitchStyle}"/>
                </Grid>
            </Border>

            <!-- 自动任务 -->
            <Border Style="{StaticResource SettingRowStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource SettingIconStyle}">
                        <TextBlock Text="&#xE9D5;" FontFamily="Segoe Fluent Icons"
                                   FontSize="15" Foreground="#0078D4"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="自动任务" FontSize="14" FontWeight="Medium" Foreground="#1A1A1A"/>
                        <TextBlock Text="自动完成日常任务" FontSize="12" Foreground="#666"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                    <ToggleButton Grid.Column="2" x:Name="AutoTaskBox"
                                  Style="{StaticResource SwitchStyle}"/>
                </Grid>
            </Border>

            <!-- 界面分组 -->
            <TextBlock Text="界面" FontSize="14" FontWeight="SemiBold" Foreground="#333"
                       Margin="4,12,0,4"/>

            <!-- 最小化到托盘 -->
            <Border Style="{StaticResource SettingRowStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource SettingIconStyle}">
                        <TextBlock Text="&#xE7F4;" FontFamily="Segoe Fluent Icons"
                                   FontSize="15" Foreground="#0078D4"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="最小化到托盘" FontSize="14" FontWeight="Medium" Foreground="#1A1A1A"/>
                        <TextBlock Text="关闭窗口时最小化到系统托盘" FontSize="12" Foreground="#666"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                    <ToggleButton Grid.Column="2" x:Name="TrayBox"
                                  Style="{StaticResource SwitchStyle}"/>
                </Grid>
            </Border>

            <!-- 账号与安全分组 -->
            <TextBlock Text="账号与安全" FontSize="14" FontWeight="SemiBold" Foreground="#333"
                       Margin="4,12,0,4"/>

            <!-- 记住密码 -->
            <Border Style="{StaticResource SettingRowStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource SettingIconStyle}">
                        <TextBlock Text="&#xE72E;" FontFamily="Segoe Fluent Icons"
                                   FontSize="15" Foreground="#0078D4"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="记住密码" FontSize="14" FontWeight="Medium" Foreground="#1A1A1A"/>
                        <TextBlock Text="本地 DPAPI 加密存储，安全保存账号密码" FontSize="12" Foreground="#666"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                    <ToggleButton Grid.Column="2" x:Name="RememberPwdBox"
                                  Style="{StaticResource SwitchStyle}"/>
                </Grid>
            </Border>

            <!-- 关于分组 -->
            <TextBlock Text="关于" FontSize="14" FontWeight="SemiBold" Foreground="#333"
                       Margin="4,12,0,4"/>

            <!-- 关于 -->
            <Border Style="{StaticResource SettingRowStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource SettingIconStyle}">
                        <TextBlock Text="&#xE946;" FontFamily="Segoe Fluent Icons"
                                   FontSize="15" Foreground="#0078D4"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="NarutoLauncher" FontSize="14" FontWeight="Medium" Foreground="#1A1A1A"/>
                        <TextBlock Text="v0.1.0 · 火影忍者OL 多账号多开启动器" FontSize="12" Foreground="#666"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
