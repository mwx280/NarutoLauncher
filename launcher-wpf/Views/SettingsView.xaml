<UserControl x:Class="NarutoLauncher.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hc="https://handyorg.github.io/handycontrol">
    <UserControl.Resources>
        <!-- 开关样式（滑轨 + 滑块） -->
        <Style x:Key="SwitchStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid>
                            <Border x:Name="Track" Background="#C8C8C8" CornerRadius="10"/>
                            <Ellipse x:Name="Thumb" Width="14" Height="14" Fill="White"
                                     HorizontalAlignment="Left" Margin="3,0,0,0"
                                     VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background"
                                        Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Thumb" Property="Margin" Value="23,0,0,0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Win11 设置项行：图标 + 名称/说明 + 开关 -->
        <Style x:Key="SettingRowStyle" TargetType="Border">
            <Setter Property="Padding" Value="20,14"/>
            <Setter Property="Background" Value="{DynamicResource RowBackground}"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Margin" Value="0,3"/>
        </Style>

        <!-- 设置项图标 -->
        <Style x:Key="SettingIconStyle" TargetType="Border">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Background" Value="{DynamicResource IconBackground}"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Margin" Value="0,0,14,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- 设置项图标文字 -->
        <Style x:Key="SettingIconTextStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- 设置项名称文字 -->
        <Style x:Key="ItemNameStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="{DynamicResource AppForeground}"/>
        </Style>

        <!-- 设置项说明文字 -->
        <Style x:Key="ItemDescStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource AppForegroundSecondary}"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>

        <!-- 分组标题 -->
        <Style x:Key="GroupTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource GroupTitle}"/>
            <Setter Property="Margin" Value="4,8,0,4"/>
        </Style>

        <!-- 页面大标题 -->
        <Style x:Key="PageTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource AppForeground}"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <!-- 主题单选按钮 -->
        <Style x:Key="ThemeRadioStyle" TargetType="RadioButton">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{DynamicResource AppForeground}"/>
            <Setter Property="Margin" Value="0,6,24,6"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer>
        <StackPanel Margin="28,20,28,24">

            <TextBlock Text="设置" Style="{StaticResource PageTitleStyle}"/>

            <!-- ===== 个性化分组 ===== -->
            <TextBlock Text="个性化" Style="{StaticResource GroupTitleStyle}"/>

            <!-- 深色模式 -->
            <Border Style="{StaticResource SettingRowStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource SettingIconStyle}">
                        <TextBlock Text="&#xE706;" Style="{StaticResource SettingIconTextStyle}"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="深色模式" Style="{StaticResource ItemNameStyle}"/>
                        <TextBlock Text="选择应用的外观模式" Style="{StaticResource ItemDescStyle}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <RadioButton x:Name="ThemeSystemRadio" Content="跟随系统"
                                         Style="{StaticResource ThemeRadioStyle}"
                                         GroupName="theme" Checked="OnThemeChanged"/>
                            <RadioButton x:Name="ThemeDarkRadio" Content="深色"
                                         Style="{StaticResource ThemeRadioStyle}"
                                         GroupName="theme" Checked="OnThemeChanged"/>
                            <RadioButton x:Name="ThemeLightRadio" Content="浅色"
                                         Style="{StaticResource ThemeRadioStyle}"
                                         GroupName="theme" Checked="OnThemeChanged"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 主题色 -->
            <Border Style="{StaticResource SettingRowStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource SettingIconStyle}">
                        <TextBlock Text="&#xE790;" Style="{StaticResource SettingIconTextStyle}"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="主题色" Style="{StaticResource ItemNameStyle}"/>
                        <TextBlock Text="选择强调色（按钮/开关/选中状态）" Style="{StaticResource ItemDescStyle}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <RadioButton x:Name="AccentSystemRadio" Content="跟随系统"
                                         Style="{StaticResource ThemeRadioStyle}"
                                         GroupName="accent" Checked="OnAccentChanged"/>
                            <RadioButton x:Name="AccentCustomRadio" Content="自定义"
                                         Style="{StaticResource ThemeRadioStyle}"
                                         GroupName="accent" Checked="OnAccentChanged"/>
                            <!-- 色板 -->
                            <StackPanel x:Name="ColorPalette" Orientation="Horizontal"
                                        Visibility="Collapsed" VerticalAlignment="Center">
                                <Border x:Name="ColorChip0" Width="22" Height="22" CornerRadius="4"
                                        Background="#E8482C" Margin="0,0,6,0" Cursor="Hand"
                                        MouseLeftButtonUp="OnColorClick" Tag="#E8482C"/>
                                <Border x:Name="ColorChip1" Width="22" Height="22" CornerRadius="4"
                                        Background="#0078D4" Margin="0,0,6,0" Cursor="Hand"
                                        MouseLeftButtonUp="OnColorClick" Tag="#0078D4"/>
                                <Border x:Name="ColorChip2" Width="22" Height="22" CornerRadius="4"
                                        Background="#107C10" Margin="0,0,6,0" Cursor="Hand"
                                        MouseLeftButtonUp="OnColorClick" Tag="#107C10"/>
                                <Border x:Name="ColorChip3" Width="22" Height="22" CornerRadius="4"
                                        Background="#8764B8" Margin="0,0,6,0" Cursor="Hand"
                                        MouseLeftButtonUp="OnColorClick" Tag="#8764B8"/>
                                <Border x:Name="ColorChip4" Width="22" Height="22" CornerRadius="4"
                                        Background="#FFB900" Margin="0,0,6,0" Cursor="Hand"
                                        MouseLeftButtonUp="OnColorClick" Tag="#FFB900"/>
                                <Border x:Name="ColorChip5" Width="22" Height="22" CornerRadius="4"
                                        Background="#00B7C3" Margin="0,0,6,0" Cursor="Hand"
                                        MouseLeftButtonUp="OnColorClick" Tag="#00B7C3"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ===== 游戏分组 ===== -->
            <TextBlock Text="游戏" Style="{StaticResource GroupTitleStyle}"/>

            <!-- 游戏变速 -->
            <Border Style="{StaticResource SettingRowStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource SettingIconStyle}">
                        <TextBlock Text="&#xE94A;" Style="{StaticResource SettingIconTextStyle}"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="游戏变速" Style="{StaticResource ItemNameStyle}"/>
                        <TextBlock Text="调整游戏运行速度" Style="{StaticResource ItemDescStyle}"/>
                    </StackPanel>
                    <ToggleButton Grid.Column="2" x:Name="GameSpeedBox"
                                  Style="{StaticResource SwitchStyle}"/>
                </Grid>
            </Border>

            <!-- 挂机防掉线 -->
            <Border Style="{StaticResource SettingRowStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource SettingIconStyle}">
                        <TextBlock Text="&#xEA18;" Style="{StaticResource SettingIconTextStyle}"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="挂机防掉线" Style="{StaticResource ItemNameStyle}"/>
                        <TextBlock Text="挂机时自动重连，防止掉线" Style="{StaticResource ItemDescStyle}"/>
                    </StackPanel>
                    <ToggleButton Grid.Column="2" x:Name="AntiDropBox"
                                  Style="{StaticResource SwitchStyle}"/>
                </Grid>
            </Border>

            <!-- ===== 自动化分组 ===== -->
            <TextBlock Text="自动化" Style="{StaticResource GroupTitleStyle}"/>

            <!-- 自动脚本 -->
            <Border Style="{StaticResource SettingRowStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource SettingIconStyle}">
                        <TextBlock Text="&#xE713;" Style="{StaticResource SettingIconTextStyle}"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="自动脚本" Style="{StaticResource ItemNameStyle}"/>
                        <TextBlock Text="自动执行预设脚本任务" Style="{StaticResource ItemDescStyle}"/>
                    </StackPanel>
                    <ToggleButton Grid.Column="2" x:Name="AutoScriptBox"
                                  Style="{StaticResource SwitchStyle}"/>
                </Grid>
            </Border>

            <!-- 自动任务 -->
            <Border Style="{StaticResource SettingRowStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource SettingIconStyle}">
                        <TextBlock Text="&#xE9D5;" Style="{StaticResource SettingIconTextStyle}"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="自动任务" Style="{StaticResource ItemNameStyle}"/>
                        <TextBlock Text="自动完成日常任务" Style="{StaticResource ItemDescStyle}"/>
                    </StackPanel>
                    <ToggleButton Grid.Column="2" x:Name="AutoTaskBox"
                                  Style="{StaticResource SwitchStyle}"/>
                </Grid>
            </Border>

            <!-- ===== 界面分组 ===== -->
            <TextBlock Text="界面" Style="{StaticResource GroupTitleStyle}"/>

            <!-- 最小化到托盘 -->
            <Border Style="{StaticResource SettingRowStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource SettingIconStyle}">
                        <TextBlock Text="&#xE7F4;" Style="{StaticResource SettingIconTextStyle}"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="最小化到托盘" Style="{StaticResource ItemNameStyle}"/>
                        <TextBlock Text="关闭窗口时最小化到系统托盘" Style="{StaticResource ItemDescStyle}"/>
                    </StackPanel>
                    <ToggleButton Grid.Column="2" x:Name="TrayBox"
                                  Style="{StaticResource SwitchStyle}"/>
                </Grid>
            </Border>

            <!-- ===== 账号与安全分组 ===== -->
            <TextBlock Text="账号与安全" Style="{StaticResource GroupTitleStyle}"/>

            <!-- 记住密码 -->
            <Border Style="{StaticResource SettingRowStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource SettingIconStyle}">
                        <TextBlock Text="&#xE72E;" Style="{StaticResource SettingIconTextStyle}"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="记住密码" Style="{StaticResource ItemNameStyle}"/>
                        <TextBlock Text="本地 DPAPI 加密存储，安全保存账号密码" Style="{StaticResource ItemDescStyle}"/>
                    </StackPanel>
                    <ToggleButton Grid.Column="2" x:Name="RememberPwdBox"
                                  Style="{StaticResource SwitchStyle}"/>
                </Grid>
            </Border>

            <!-- ===== 关于分组 ===== -->
            <TextBlock Text="关于" Style="{StaticResource GroupTitleStyle}"/>

            <!-- 关于 -->
            <Border Style="{StaticResource SettingRowStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource SettingIconStyle}">
                        <TextBlock Text="&#xE946;" Style="{StaticResource SettingIconTextStyle}"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="NarutoLauncher" Style="{StaticResource ItemNameStyle}"/>
                        <TextBlock Text="v0.1.0 · 火影忍者OL 多账号多开启动器"
                                   Style="{StaticResource ItemDescStyle}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
