<UserControl x:Class="NarutoLauncher.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel Margin="20" MaxWidth="600" HorizontalAlignment="Left">
            <TextBlock Text="设置" FontSize="20" FontWeight="Bold" Foreground="#2B2118"/>

            <GroupBox Header="游戏" Margin="0,16,0,0" Padding="12">
                <StackPanel>
                    <CheckBox x:Name="GameSpeedBox" Content="游戏变速" Margin="0,4"/>
                    <CheckBox x:Name="AntiDropBox" Content="挂机防掉线" Margin="0,4"/>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="自动化" Margin="0,12,0,0" Padding="12">
                <StackPanel>
                    <CheckBox x:Name="AutoScriptBox" Content="自动脚本" Margin="0,4"/>
                    <CheckBox x:Name="AutoTaskBox" Content="自动任务" Margin="0,4"/>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="界面" Margin="0,12,0,0" Padding="12">
                <StackPanel>
                    <CheckBox x:Name="TrayBox" Content="最小化到托盘" Margin="0,4"/>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="账号与安全" Margin="0,12,0,0" Padding="12">
                <StackPanel>
                    <CheckBox x:Name="RememberPwdBox" Content="记住密码（本地 DPAPI 加密存储）" Margin="0,4"/>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="关于" Margin="0,12,0,0" Padding="12">
                <StackPanel>
                    <TextBlock Text="NarutoLauncher v0.1.0"/>
                    <TextBlock Text="火影忍者OL 启动器 · 多账号多开" Foreground="#8A7A66"/>
                </StackPanel>
            </GroupBox>
        </StackPanel>
    </ScrollViewer>
</UserControl>
