<UserControl x:Class="NarutoLauncher.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hc="https://handyorg.github.io/handycontrol">
    <ScrollViewer>
        <StackPanel Margin="24" MaxWidth="980">
            <TextBlock Text="火影忍者OL" FontSize="26" FontWeight="Bold" Foreground="#E8482C"/>
            <TextBlock Text="忍界大战 · 多开登录 · 一键加速 · 自动挂机"
                       Foreground="#8A7A66" Margin="0,4,0,16"/>

            <Button Content="开始游戏" Style="{StaticResource ButtonPrimary}" Width="180" Height="40"
                    HorizontalAlignment="Left" FontSize="15" FontWeight="Bold" Click="OnStartGame"/>

            <TextBlock Text="我的账号" FontSize="17" FontWeight="SemiBold" Foreground="#333"
                       Margin="0,24,0,8"/>
            <ItemsControl x:Name="AccountList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="#E8E8E8" BorderThickness="1" CornerRadius="8"
                                Background="White" Padding="14" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="42" Height="42" CornerRadius="21"
                                        Background="#E8482C" Margin="0,0,12,0">
                                    <TextBlock Text="{Binding AvatarChar}" Foreground="White"
                                               FontSize="17" HorizontalAlignment="Center"
                                               VerticalAlignment="Center" FontWeight="Bold"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"
                                               Foreground="#333"/>
                                    <TextBlock Text="{Binding InfoText}" Foreground="#8A7A66"
                                               FontSize="12" Margin="0,2,0,0"/>
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding RunText}"
                                           VerticalAlignment="Center" Foreground="#E8482C"
                                           FontSize="12"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="功能设置" FontSize="17" FontWeight="SemiBold" Foreground="#333"
                       Margin="0,24,0,8"/>
            <WrapPanel>
                <CheckBox x:Name="GameSpeedBox" Content="游戏变速" Margin="0,0,20,10" IsChecked="True"/>
                <CheckBox x:Name="AntiDropBox" Content="挂机防掉线" Margin="0,0,20,10" IsChecked="True"/>
                <CheckBox x:Name="AutoScriptBox" Content="自动脚本" Margin="0,0,20,10"/>
                <CheckBox x:Name="AutoTaskBox" Content="自动任务" Margin="0,0,20,10"/>
                <CheckBox x:Name="TrayBox" Content="最小化到托盘" Margin="0,0,20,10" IsChecked="True"/>
            </WrapPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
