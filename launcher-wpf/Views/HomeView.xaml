<UserControl x:Class="NarutoLauncher.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hc="https://handyorg.github.io/handycontrol">
    <Grid Background="{DynamicResource AppBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <!-- 公告标题栏 -->
        <Grid Grid.Row="0" Margin="24,16,24,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <TextBlock Text="公告" FontSize="18" FontWeight="Bold"
                           Foreground="{DynamicResource AppForeground}"
                           VerticalAlignment="Center"/>
                <ProgressBar x:Name="LoadingBar" Width="100" Height="4" IsIndeterminate="True"
                             Margin="12,0,0,0" VerticalAlignment="Center"
                             Visibility="Collapsed"/>
            </StackPanel>
            <Button Grid.Column="1" x:Name="RefreshBtn" Content="刷新" Padding="16,5"
                    Background="{DynamicResource RowBackground}"
                    Foreground="{DynamicResource AppForeground}"
                    BorderBrush="{DynamicResource CardBorder}"
                    Click="OnRefresh"/>
        </Grid>

        <!-- 公告列表（含加载覆盖层） -->
        <Grid Grid.Row="1" Margin="24,0,24,20">
            <ScrollViewer x:Name="ListScroll" VerticalScrollBarVisibility="Auto"
                          Background="{DynamicResource AppBackground}"
                          BorderBrush="{DynamicResource CardBorder}" BorderThickness="1">
                <ItemsControl x:Name="NewsList" Background="Transparent">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{DynamicResource CardBorder}" BorderThickness="0,0,0,1"
                                    Padding="14,12" Background="Transparent" Cursor="Hand"
                                    PreviewMouseLeftButtonUp="OnNewsClick">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="{DynamicResource AccentFaint}"
                                            CornerRadius="4"
                                            Padding="6,2" Margin="0,0,10,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Category}"
                                                   Foreground="{DynamicResource AccentBrush}"
                                                   FontSize="12"/>
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="{Binding Title}"
                                               Foreground="{DynamicResource AppForeground}" FontSize="14"
                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Date}"
                                               Foreground="{DynamicResource AppForegroundSecondary}"
                                               FontSize="12"
                                               Margin="12,0,0,0" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- 加载覆盖层 -->
            <Border x:Name="LoadingOverlay" Background="{DynamicResource AppBackground}"
                    CornerRadius="8">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ProgressBar Width="200" Height="6" IsIndeterminate="True"/>
                    <TextBlock Text="正在加载公告..." FontSize="14"
                               Foreground="{DynamicResource AppForegroundSecondary}"
                               HorizontalAlignment="Center" Margin="0,16,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
