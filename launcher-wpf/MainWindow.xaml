<Window x:Class="NarutoLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:NarutoLauncher.Views"
        Title="火影忍者OL 启动器" Height="720" Width="1200"
        WindowStartupLocation="CenterScreen"
        MinHeight="600" MinWidth="900">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 左侧导航 -->
        <Border Grid.Column="0" Background="#F3F3F3" BorderBrush="#D9D9D9" BorderThickness="0,0,1,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="火影忍者OL" FontSize="16" FontWeight="Bold"
                           Margin="16,20,16,16" Foreground="#2B2118"/>
                <ListBox x:Name="NavList" BorderThickness="0" Background="Transparent"
                         SelectionChanged="OnNavChanged" SelectedIndex="0">
                    <ListBoxItem Content="首页"/>
                    <ListBoxItem Content="游戏"/>
                    <ListBoxItem Content="账号管理"/>
                    <ListBoxItem Content="设置"/>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- 右侧内容 -->
        <Grid Grid.Column="1" Background="White">
            <ContentControl x:Name="ContentHost"/>
        </Grid>
    </Grid>
</Window>
