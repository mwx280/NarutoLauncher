<hc:Window x:Class="NarutoLauncher.MainWindow"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:hc="https://handyorg.github.io/handycontrol"
           xmlns:views="clr-namespace:NarutoLauncher.Views"
           Title="火影忍者OL 启动器" Height="720" Width="1200"
           WindowStartupLocation="CenterScreen"
           MinHeight="600" MinWidth="900">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 左侧导航 -->
        <Border Grid.Column="0" Background="#FAFAFA" BorderBrush="#E0E0E0" BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="20,24,20,20">
                    <TextBlock Text="火影忍者OL" FontSize="18" FontWeight="Bold" Foreground="#E8482C"/>
                    <TextBlock Text="启动器" FontSize="12" Foreground="#999" Margin="0,2,0,0"/>
                </StackPanel>
                <ListBox x:Name="NavList" BorderThickness="0" Background="Transparent"
                         SelectionChanged="OnNavChanged" SelectedIndex="0"
                         FontSize="14">
                    <ListBoxItem Content="🏠  首页" Padding="20,10"/>
                    <ListBoxItem Content="🎮  游戏" Padding="20,10"/>
                    <ListBoxItem Content="👥  账号管理" Padding="20,10"/>
                    <ListBoxItem Content="⚙️  设置" Padding="20,10"/>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- 右侧内容 -->
        <Grid Grid.Column="1">
            <ContentControl x:Name="ContentHost"/>
        </Grid>
    </Grid>
</hc:Window>
