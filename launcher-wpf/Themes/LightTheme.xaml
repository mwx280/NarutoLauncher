<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===== 浅色主题 ===== -->
    <SolidColorBrush x:Key="AppBackground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="AppForeground" Color="#1A1A1A"/>
    <SolidColorBrush x:Key="AppForegroundSecondary" Color="#666666"/>
    <SolidColorBrush x:Key="CardBackground" Color="#F5F5F5"/>
    <SolidColorBrush x:Key="CardBorder" Color="#E8E8E8"/>
    <SolidColorBrush x:Key="RowBackground" Color="#F5F5F5"/>
    <SolidColorBrush x:Key="NavBackground" Color="#FAFAFA"/>
    <SolidColorBrush x:Key="IconBackground" Color="#E8E8E8"/>
    <SolidColorBrush x:Key="GroupTitle" Color="#333333"/>

    <!-- 输入控件 -->
    <SolidColorBrush x:Key="InputBackground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="InputBorder" Color="#D0D0D0"/>

</ResourceDictionary>
