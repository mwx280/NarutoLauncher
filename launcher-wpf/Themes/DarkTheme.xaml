<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===== 深色主题 ===== -->
    <SolidColorBrush x:Key="AppBackground" Color="#1F1F1F"/>
    <SolidColorBrush x:Key="AppForeground" Color="#F3F3F3"/>
    <SolidColorBrush x:Key="AppForegroundSecondary" Color="#9A9A9A"/>
    <SolidColorBrush x:Key="CardBackground" Color="#2B2B2B"/>
    <SolidColorBrush x:Key="CardBorder" Color="#3A3A3A"/>
    <SolidColorBrush x:Key="RowBackground" Color="#2B2B2B"/>
    <SolidColorBrush x:Key="NavBackground" Color="#262626"/>
    <SolidColorBrush x:Key="IconBackground" Color="#3A3A3A"/>
    <SolidColorBrush x:Key="GroupTitle" Color="#CCCCCC"/>

    <!-- 输入控件 -->
    <SolidColorBrush x:Key="InputBackground" Color="#3A3A3A"/>
    <SolidColorBrush x:Key="InputBorder" Color="#4A4A4A"/>

</ResourceDictionary>
