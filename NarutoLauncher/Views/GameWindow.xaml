<ui:FluentWindow x:Class="NarutoLauncher.Views.GameWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:views="clr-namespace:NarutoLauncher.Views"
                 Title="火影忍者OL"
                 Icon="/assets/favicon.png"
                 Height="800" Width="1200"
                 MinHeight="400" MinWidth="600"
                 WindowStartupLocation="CenterOwner"
                 WindowStyle="None"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round">
    <DockPanel>
        <!-- 标题栏：窗口图标右侧为多开游戏标签（WPF-UI 原生 TabView），右侧为刷新/全屏/系统按钮 -->
        <ui:TitleBar x:Name="TitleBarHost" DockPanel.Dock="Top"
                     Title="{x:Null}"
                     Icon="{ui:ImageIcon '/assets/favicon.png'}"
                     ShowMaximize="True" ShowMinimize="True" ShowClose="True">
            <ui:TitleBar.Header>
                <ui:TabView x:Name="TabBar" Margin="6,0,6,0"
                            Background="Transparent" BorderThickness="0"
                            TabStripPlacement="Top"
                            VerticalAlignment="Center"
                            SelectionChanged="OnTabSelectionChanged">
                    <ui:TabView.ItemContainerStyle>
                        <Style TargetType="{x:Type ui:TabViewItem}">
                            <Setter Property="Padding" Value="12,4"/>
                            <Setter Property="Margin" Value="0,2,4,2"/>
                            <Setter Property="FontSize" Value="13"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type ui:TabViewItem}">
                                        <Border x:Name="Bd"
                                                Background="Transparent"
                                                CornerRadius="6"
                                                Padding="{TemplateBinding Padding}"
                                                Margin="{TemplateBinding Margin}">
                                            <ContentPresenter ContentSource="Header"
                                                              VerticalAlignment="Center"
                                                              HorizontalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background"
                                                        Value="{DynamicResource ControlFillColorSecondaryBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background"
                                                        Value="{DynamicResource ControlFillColorSecondaryBrush}"/>
                                                <Setter Property="Foreground"
                                                        Value="{DynamicResource TextFillColorPrimaryBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ui:TabView.ItemContainerStyle>
                </ui:TabView>
            </ui:TitleBar.Header>
            <ui:TitleBar.TrailingContent>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="RefreshBtn"
                            Width="44" Height="30" Padding="0"
                            VerticalAlignment="Top"
                            Background="Transparent"
                            ToolTip="重新加载当前选中的游戏页面"
                            Click="OnRefreshGame">
                        <Button.Template>
                            <ControlTemplate TargetType="{x:Type Button}">
                                <Grid x:Name="LayoutRoot" Background="{TemplateBinding Background}">
                                    <Viewbox Width="11" Height="11"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center"
                                             Focusable="False"
                                             RenderOptions.BitmapScalingMode="HighQuality">
                                        <Canvas Width="72" Height="72" Focusable="False">
                                            <Path Data="M6.2,0.4 L0,6.6 V8.4 L6.2,8.4 L6.2,8.6 L4,11 H5 L8,8.4 H10 L6,11 H7 L11,8.4 H13 L14,7.4 L12.5,7.2 L14,6 L13,5 L11,6.5 L10,6.5 L6,2.5 L6,4 L2.5,7.5 L1.5,6.5 L6,2 L6,0.4 Z"
                                                  Fill="{Binding ButtonsForeground, RelativeSource={RelativeSource AncestorType={x:Type ui:TitleBar}}}"/>
                                        </Canvas>
                                    </Viewbox>
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="LayoutRoot" Property="Background"
                                                Value="{Binding ButtonsBackground, RelativeSource={RelativeSource AncestorType={x:Type ui:TitleBar}}}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button x:Name="FullscreenBtn"
                            Width="44" Height="30" Padding="0"
                            VerticalAlignment="Top"
                            Background="Transparent"
                            ToolTip="全屏"
                            Click="OnToggleFullscreen">
                        <Button.Template>
                            <ControlTemplate TargetType="{x:Type Button}">
                                <Grid x:Name="LayoutRoot" Background="{TemplateBinding Background}">
                                    <Viewbox Width="11" Height="11"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center"
                                             Focusable="False"
                                             RenderOptions.BitmapScalingMode="HighQuality">
                                        <Canvas Width="72" Height="72" Focusable="False">
                                            <Path Data="M0,0 H28 L20,8 H8 V20 L0,28 Z M72,0 H44 L52,8 H64 V20 L72,28 Z M0,72 H28 L20,64 H8 V52 L0,44 Z M72,72 H44 L52,64 H64 V52 L72,44 Z"
                                                  Fill="{Binding ButtonsForeground, RelativeSource={RelativeSource AncestorType={x:Type ui:TitleBar}}}"/>
                                        </Canvas>
                                    </Viewbox>
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="LayoutRoot" Property="Background"
                                                Value="{Binding ButtonsBackground, RelativeSource={RelativeSource AncestorType={x:Type ui:TitleBar}}}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </ui:TitleBar.TrailingContent>
        </ui:TitleBar>

        <!-- 内嵌游戏窗口区域（多账号会话各自一个 GameHostView，切换时控制可见性） -->
        <Border Background="#1E1E1E" ClipToBounds="True">
            <Grid>
                <StackPanel x:Name="Placeholder" HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <TextBlock x:Name="PlaceholderText" Text="尚未启动游戏" FontSize="15" Foreground="#999"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="在「账号管理」页点击账号的开始游戏按钮即可添加标签" FontSize="12" Foreground="#777"
                               HorizontalAlignment="Center" Margin="0,6,0,0"/>
                </StackPanel>
                <Grid x:Name="GameHostContainer"/>
            </Grid>
        </Border>
    </DockPanel>
</ui:FluentWindow>