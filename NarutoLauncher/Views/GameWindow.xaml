<ui:FluentWindow x:Class="NarutoLauncher.Views.GameWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
                 xmlns:views="clr-namespace:NarutoLauncher.Views"
                 Title="火影忍者Online 启动器"
                 Icon="/assets/favicon.png"
                 Height="800" Width="1200"
                 MinHeight="400" MinWidth="600"
                 WindowStartupLocation="CenterScreen"
                 WindowStyle="None"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="None"
                 WindowCornerPreference="Round"
                 BorderBrush="Black"
                 BorderThickness="1">
    <ui:FluentWindow.Resources>
        <!-- 用户列表账号项按钮 -->
        <Style x:Key="UserItemButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="MinWidth" Value="170"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource ControlFillColorSecondaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 倍速菜单选项：列表项样式（hover 浅背景，选中圆点 + 强调色文字） -->
        <Style x:Key="SpeedRadioStyle" TargetType="{x:Type RadioButton}">
            <Setter Property="Foreground" Value="#C8CBD0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RadioButton}">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6"
                                Padding="10,7" Margin="0,1" MinWidth="130">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="Dot" Width="7" Height="7" Margin="0,0,9,0"
                                         VerticalAlignment="Center" Fill="Transparent"/>
                                <ContentPresenter/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3C4043"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="#6CB5FF"/>
                                <Setter TargetName="Dot" Property="Fill" Value="#0F6CBD"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="86"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 顶部 UI（标签条 + 工具栏，WebView2 渲染） -->
        <wv2:WebView2 x:Name="WebUi" Grid.Row="0"/>

        <!-- 内嵌游戏窗口区域（多账号会话各自一个 GameHostView，切换时控制可见性） -->
        <Border Grid.Row="1" Background="#1E1E1E" ClipToBounds="True">
            <Grid>
                <StackPanel x:Name="Placeholder" HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <TextBlock x:Name="PlaceholderText" Text="尚未启动游戏" FontSize="15" Foreground="#999"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="在「账号管理」页点击账号的开始游戏按钮即可添加标签" FontSize="12" Foreground="#777"
                               HorizontalAlignment="Center" Margin="0,6,0,0"/>
                </StackPanel>
                <Grid x:Name="GameHostContainer"/>
            </Grid>
        </Border>

        <!-- 账号切换菜单（点击「账号」按钮显示） -->
        <Popup x:Name="UserMenuPopup" Placement="Relative"
               PlacementTarget="{Binding ElementName=WebUi}"
               AllowsTransparency="True" StaysOpen="False" PopupAnimation="Fade"
               IsOpen="False">
            <Border Background="#26282C"
                    BorderBrush="#3A3C41"
                    BorderThickness="1" CornerRadius="8" Padding="6"
                    MaxHeight="360">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="UserListPanel"/>
                </ScrollViewer>
            </Border>
        </Popup>

        <!-- 倍速菜单（点击「倍速」按钮显示） -->
        <Popup x:Name="SpeedMenuPopup" Placement="Relative"
               PlacementTarget="{Binding ElementName=WebUi}"
               AllowsTransparency="True" StaysOpen="True" PopupAnimation="Fade"
               IsOpen="False">
            <Border Background="#26282C"
                    BorderBrush="#3A3C41"
                    BorderThickness="1" CornerRadius="8" Padding="6"
                    MinWidth="150"
                    MouseLeave="OnSpeedMenuMouseLeave">
                <StackPanel>
                    <TextBlock Text="倍速" FontSize="12" FontWeight="SemiBold"
                               Foreground="#9AA0A6"
                               Margin="8,2,0,6"/>
                    <RadioButton x:Name="Speed05" Content="0.5 倍速" GroupName="SpeedGroup" Tag="5"
                                 Style="{StaticResource SpeedRadioStyle}" FontSize="13"
                                 Checked="OnSpeedChanged"/>
                    <RadioButton x:Name="Speed1" Content="1 倍速" GroupName="SpeedGroup" Tag="10"
                                 Style="{StaticResource SpeedRadioStyle}" FontSize="13"
                                 Checked="OnSpeedChanged"/>
                    <RadioButton x:Name="Speed2" Content="2 倍速" GroupName="SpeedGroup" Tag="20"
                                 Style="{StaticResource SpeedRadioStyle}" FontSize="13"
                                 Checked="OnSpeedChanged"/>
                    <RadioButton x:Name="Speed4" Content="4 倍速" GroupName="SpeedGroup" Tag="40"
                                 Style="{StaticResource SpeedRadioStyle}" FontSize="13"
                                 Checked="OnSpeedChanged"/>
                    <StackPanel Orientation="Horizontal" Margin="10,4,10,2">
                        <RadioButton x:Name="SpeedCustom" Content="自定义" GroupName="SpeedGroup" Tag="custom"
                                     Style="{StaticResource SpeedRadioStyle}" FontSize="13"
                                     Checked="OnSpeedChanged"/>
                        <TextBox x:Name="CustomSpeedBox" Width="52" FontSize="12"
                                 VerticalContentAlignment="Center" Margin="6,0,0,0"
                                 Padding="4,2" Background="#1E1E1E" Foreground="#E8EAED"
                                 BorderBrush="#3A3C41" BorderThickness="1"
                                 ToolTip="输入倍速，如 1.5、3、10"
                                 PreviewMouseDown="OnCustomSpeedBoxPreviewMouseDown"
                                 KeyDown="OnCustomSpeedKeyDown"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Popup>

        <!-- 对话框宿主（ContentDialog 构造时指定，显示在本窗口） -->
        <ui:ContentDialogHost x:Name="ContentDialogHost" IsDisableSiblingsEnabled="True"/>
    </Grid>
</ui:FluentWindow>
