<ui:FluentWindow x:Class="NarutoLauncher.Views.GameWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:views="clr-namespace:NarutoLauncher.Views"
                 Title="火影忍者Online"
                 Icon="/assets/favicon.png"
                 Height="800" Width="1200"
                 MinHeight="400" MinWidth="600"
                 WindowStartupLocation="CenterOwner"
                 WindowStyle="None"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round">
    <ui:FluentWindow.Resources>
        <!-- 用户列表账号项按钮 -->
        <Style x:Key="UserItemButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="MinWidth" Value="170"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource ControlFillColorSecondaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </ui:FluentWindow.Resources>
    <Grid>
        <DockPanel>
        <!-- 标题栏：窗口图标右侧为多开游戏标签（WPF-UI 原生 TabView），右侧为刷新/全屏/系统按钮 -->
        <ui:TitleBar x:Name="TitleBarHost" DockPanel.Dock="Top"
                     Title="{x:Null}"
                     Icon="{ui:ImageIcon '/assets/favicon.png'}"
                     ShowMaximize="True" ShowMinimize="True" ShowClose="True">
            <ui:TitleBar.Header>
                <DockPanel>
                    <TextBlock Text="火影忍者Online" VerticalAlignment="Center"
                               Margin="0,0,12,0"
                               FontSize="14"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    <ui:TabView x:Name="TabBar" Margin="6,0,6,0"
                                Background="Transparent" BorderThickness="0"
                                TabStripPlacement="Top"
                                VerticalAlignment="Center"
                                SelectionChanged="OnTabSelectionChanged">
                    <ui:TabView.ItemContainerStyle>
                        <Style TargetType="{x:Type ui:TabViewItem}">
                            <Setter Property="Padding" Value="16,7"/>
                            <Setter Property="Margin" Value="0,2,8,2"/>
                            <Setter Property="FontSize" Value="14"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type ui:TabViewItem}">
                                        <Border x:Name="Bd"
                                                Background="{DynamicResource ControlFillColorDefaultBrush}"
                                                CornerRadius="10"
                                                Padding="{TemplateBinding Padding}"
                                                Margin="{TemplateBinding Margin}">
                                            <ContentPresenter ContentSource="Header"
                                                              VerticalAlignment="Center"
                                                              HorizontalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background"
                                                        Value="{DynamicResource ControlFillColorSecondaryBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background"
                                                        Value="{DynamicResource AccentFillColorDefaultBrush}"/>
                                                <Setter Property="Foreground"
                                                        Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}"/>
                                                <Setter TargetName="Bd" Property="Effect">
                                                    <Setter.Value>
                                                        <DropShadowEffect BlurRadius="8" ShadowDepth="0"
                                                                          Opacity="0.35" Color="Black"/>
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ui:TabView.ItemContainerStyle>
                </ui:TabView>
                </DockPanel>
            </ui:TitleBar.Header>
            <ui:TitleBar.TrailingContent>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="RefreshBtn"
                            Width="44" Height="30" Padding="0"
                            VerticalAlignment="Top"
                            Background="Transparent"
                            ToolTip="重新加载当前选中的游戏页面"
                            Click="OnRefreshGame">
                        <Button.Template>
                            <ControlTemplate TargetType="{x:Type Button}">
                                <Grid x:Name="LayoutRoot" Background="{TemplateBinding Background}">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="LayoutRoot" Property="Background"
                                                Value="{Binding ButtonsBackground, RelativeSource={RelativeSource AncestorType={x:Type ui:TitleBar}}}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <ui:SymbolIcon Symbol="ArrowClockwise20" FontSize="16"
                                       Foreground="{Binding ButtonsForeground, RelativeSource={RelativeSource AncestorType={x:Type ui:TitleBar}}}"/>
                    </Button>
                    <Button x:Name="SelectServerBtn"
                            Width="44" Height="30" Padding="0"
                            VerticalAlignment="Top"
                            Background="Transparent"
                            ToolTip="选区（回到官网选区页）"
                            Click="OnSelectServer">
                        <Button.Template>
                            <ControlTemplate TargetType="{x:Type Button}">
                                <Grid x:Name="LayoutRoot" Background="{TemplateBinding Background}">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="LayoutRoot" Property="Background"
                                                Value="{Binding ButtonsBackground, RelativeSource={RelativeSource AncestorType={x:Type ui:TitleBar}}}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <ui:SymbolIcon Symbol="Map20" FontSize="16"
                                       Foreground="{Binding ButtonsForeground, RelativeSource={RelativeSource AncestorType={x:Type ui:TitleBar}}}"/>
                    </Button>
                    <Button x:Name="MuteBtn"
                            Width="44" Height="30" Padding="0"
                            VerticalAlignment="Top"
                            Background="Transparent"
                            ToolTip="静音"
                            Click="OnToggleMute">
                        <Button.Template>
                            <ControlTemplate TargetType="{x:Type Button}">
                                <Grid x:Name="LayoutRoot" Background="{TemplateBinding Background}">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="LayoutRoot" Property="Background"
                                                Value="{Binding ButtonsBackground, RelativeSource={RelativeSource AncestorType={x:Type ui:TitleBar}}}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <ui:SymbolIcon x:Name="MuteIcon" Symbol="Speaker220" FontSize="16"
                                       Foreground="{Binding ButtonsForeground, RelativeSource={RelativeSource AncestorType={x:Type ui:TitleBar}}}"/>
                    </Button>
                    <Button x:Name="SpeedBtn"
                            Width="44" Height="30" Padding="0"
                            VerticalAlignment="Top"
                            Background="Transparent"
                            ToolTip="倍速"
                            MouseEnter="OnSpeedBtnMouseEnter">
                        <Button.Template>
                            <ControlTemplate TargetType="{x:Type Button}">
                                <Grid x:Name="LayoutRoot" Background="{TemplateBinding Background}">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="LayoutRoot" Property="Background"
                                                Value="{Binding ButtonsBackground, RelativeSource={RelativeSource AncestorType={x:Type ui:TitleBar}}}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <ui:SymbolIcon Symbol="FastForward20" FontSize="16"
                                       Foreground="{Binding ButtonsForeground, RelativeSource={RelativeSource AncestorType={x:Type ui:TitleBar}}}"/>
                    </Button>
                    <Button x:Name="UserBtn"
                            Width="44" Height="30" Padding="0"
                            VerticalAlignment="Top"
                            Background="Transparent"
                            ToolTip="切换游戏账号"
                            MouseEnter="OnUserBtnMouseEnter">
                        <Button.Template>
                            <ControlTemplate TargetType="{x:Type Button}">
                                <Grid x:Name="LayoutRoot" Background="{TemplateBinding Background}">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="LayoutRoot" Property="Background"
                                                Value="{Binding ButtonsBackground, RelativeSource={RelativeSource AncestorType={x:Type ui:TitleBar}}}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <ui:SymbolIcon Symbol="Person20" FontSize="16"
                                       Foreground="{Binding ButtonsForeground, RelativeSource={RelativeSource AncestorType={x:Type ui:TitleBar}}}"/>
                    </Button>
                    <Button x:Name="FullscreenBtn"
                            Width="44" Height="30" Padding="0"
                            VerticalAlignment="Top"
                            Background="Transparent"
                            ToolTip="全屏"
                            Click="OnToggleFullscreen">
                        <Button.Template>
                            <ControlTemplate TargetType="{x:Type Button}">
                                <Grid x:Name="LayoutRoot" Background="{TemplateBinding Background}">
                                    <Viewbox Width="11" Height="11"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center"
                                             Focusable="False"
                                             RenderOptions.BitmapScalingMode="HighQuality">
                                        <Canvas Width="72" Height="72" Focusable="False">
                                            <Path Data="M0,0 H28 L20,8 H8 V20 L0,28 Z M72,0 H44 L52,8 H64 V20 L72,28 Z M0,72 H28 L20,64 H8 V52 L0,44 Z M72,72 H44 L52,64 H64 V52 L72,44 Z"
                                                  Fill="{Binding ButtonsForeground, RelativeSource={RelativeSource AncestorType={x:Type ui:TitleBar}}}"/>
                                        </Canvas>
                                    </Viewbox>
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="LayoutRoot" Property="Background"
                                                Value="{Binding ButtonsBackground, RelativeSource={RelativeSource AncestorType={x:Type ui:TitleBar}}}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </ui:TitleBar.TrailingContent>
        </ui:TitleBar>

        <!-- 内嵌游戏窗口区域（多账号会话各自一个 GameHostView，切换时控制可见性） -->
        <Border Background="#1E1E1E" ClipToBounds="True">
            <Grid>
                <StackPanel x:Name="Placeholder" HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <TextBlock x:Name="PlaceholderText" Text="尚未启动游戏" FontSize="15" Foreground="#999"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="在「账号管理」页点击账号的开始游戏按钮即可添加标签" FontSize="12" Foreground="#777"
                               HorizontalAlignment="Center" Margin="0,6,0,0"/>
                </StackPanel>
                <Grid x:Name="GameHostContainer"/>
            </Grid>
        </Border>
        </DockPanel>

        <!-- 用户图标 hover：游戏账号切换列表（放 Grid 重叠层，不参与 DockPanel 布局） -->
        <Popup x:Name="UserMenuPopup"
               PlacementTarget="{Binding ElementName=UserBtn}"
               Placement="Bottom" AllowsTransparency="True"
               StaysOpen="False" PopupAnimation="Fade"
               IsOpen="False">
            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="6"
                    Margin="0,4,0,0" MaxHeight="360">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="UserList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource UserItemButtonStyle}"
                                        Content="{Binding DisplayName}"
                                        Tag="{Binding}" Click="OnUserAccountClick"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </Popup>

        <!-- 倍速 hover 菜单 -->
        <Popup x:Name="SpeedMenuPopup"
               PlacementTarget="{Binding ElementName=SpeedBtn}"
               Placement="Bottom" AllowsTransparency="True"
               StaysOpen="False" PopupAnimation="Fade"
               IsOpen="False">
            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="8"
                    Margin="0,4,0,0" MinWidth="140">
                <StackPanel>
                    <TextBlock Text="倍速" FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Margin="4,0,0,6"/>
                    <RadioButton Content="0.5 倍速" GroupName="SpeedGroup" Tag="5"
                                 Margin="4,3" FontSize="13"
                                 Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                 Checked="OnSpeedChanged"/>
                    <RadioButton Content="1 倍速" GroupName="SpeedGroup" Tag="10" IsChecked="True"
                                 Margin="4,3" FontSize="13"
                                 Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                 Checked="OnSpeedChanged"/>
                    <RadioButton Content="2 倍速" GroupName="SpeedGroup" Tag="20"
                                 Margin="4,3" FontSize="13"
                                 Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                 Checked="OnSpeedChanged"/>
                    <RadioButton Content="4 倍速" GroupName="SpeedGroup" Tag="40"
                                 Margin="4,3" FontSize="13"
                                 Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                 Checked="OnSpeedChanged"/>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</ui:FluentWindow>