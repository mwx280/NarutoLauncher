<ui:FluentWindow x:Class="NarutoLauncher.Views.GameWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:views="clr-namespace:NarutoLauncher.Views"
                 Title="火影忍者Online"
                 Icon="/assets/favicon.png"
                 Height="800" Width="1200"
                 MinHeight="400" MinWidth="600"
                 WindowStartupLocation="CenterOwner"
                 WindowStyle="None"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 BorderBrush="Black"
                 BorderThickness="1">
    <ui:FluentWindow.Resources>
        <!-- 用户列表账号项按钮 -->
        <Style x:Key="UserItemButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="MinWidth" Value="170"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource ControlFillColorSecondaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 工具栏按钮：图标 + 文字，hover 整体变亮（仿 Chrome） -->
        <Style x:Key="ToolBarButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#9AA0A6"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Margin" Value="0,0,2,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Grid x:Name="LayoutRoot" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="LayoutRoot" Property="Background" Value="#3C4043"/>
                                <Setter Property="Foreground" Value="#E8EAED"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <DockPanel>
            <!-- 标题栏：窗口图标右侧为多开游戏标签，右侧系统按钮 -->
            <ui:TitleBar x:Name="TitleBarHost" DockPanel.Dock="Top"
                         Title="{x:Null}"
                         Icon="{ui:ImageIcon '/assets/favicon.png'}"
                         Height="40"
                         ShowMaximize="True" ShowMinimize="True" ShowClose="True">
                <ui:TitleBar.Header>
                    <DockPanel>
                        <TextBlock Text="火影忍者Online" VerticalAlignment="Center"
                                   Margin="0,0,12,0"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <ui:TabView x:Name="TabBar" Margin="6,0,6,0"
                                    Background="Transparent" BorderThickness="0"
                                    TabStripPlacement="Top"
                                    Height="28"
                                    VerticalAlignment="Center"
                                    SelectionChanged="OnTabSelectionChanged">
                            <ui:TabView.ItemContainerStyle>
                                <Style TargetType="{x:Type ui:TabViewItem}">
                                    <Setter Property="Padding" Value="14,5"/>
                                    <Setter Property="Margin" Value="0,0,4,0"/>
                                    <Setter Property="FontSize" Value="12"/>
                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="{x:Type ui:TabViewItem}">
                                                <Border x:Name="Bd"
                                                        Background="Transparent"
                                                        CornerRadius="8"
                                                        Padding="{TemplateBinding Padding}"
                                                        Margin="{TemplateBinding Margin}">
                                                    <ContentPresenter ContentSource="Header"
                                                                      VerticalAlignment="Center"
                                                                      HorizontalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="Background"
                                                                Value="{DynamicResource ControlFillColorSecondaryBrush}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="Bd" Property="Background"
                                                                Value="{DynamicResource AccentFillColorDefaultBrush}"/>
                                                        <Setter Property="Foreground"
                                                                Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ui:TabView.ItemContainerStyle>
                        </ui:TabView>
                    </DockPanel>
                </ui:TitleBar.Header>
            </ui:TitleBar>

            <!-- 工具栏（标题栏下方，深色背景，图标 + 文字） -->
            <Border DockPanel.Dock="Top" Background="#1E1E1E"
                    BorderBrush="Black" BorderThickness="0,1,0,0">
                <StackPanel Orientation="Horizontal" Margin="8,6,0,6"
                            VerticalAlignment="Center">
                    <Button x:Name="RefreshBtn" Style="{StaticResource ToolBarButtonStyle}"
                            ToolTip="重新加载当前选中的游戏页面"
                            Click="OnRefreshGame">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="ArrowClockwise20" FontSize="14"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"/>
                            <TextBlock Text="刷新" FontSize="12"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                       Margin="6,0,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="SelectServerBtn" Style="{StaticResource ToolBarButtonStyle}"
                            ToolTip="选区（回到官网选区页）"
                            Click="OnSelectServer">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Map20" FontSize="14"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"/>
                            <TextBlock Text="选区" FontSize="12"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                       Margin="6,0,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="MuteBtn" Style="{StaticResource ToolBarButtonStyle}"
                            ToolTip="静音"
                            Click="OnToggleMute">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon x:Name="MuteIcon" Symbol="Speaker220" FontSize="14"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"/>
                            <TextBlock Text="静音" FontSize="12"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                       Margin="6,0,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="SpeedBtn" Style="{StaticResource ToolBarButtonStyle}"
                            ToolTip="倍速"
                            MouseEnter="OnSpeedBtnMouseEnter"
                            MouseLeave="OnSpeedBtnMouseLeave">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="FastForward20" FontSize="14"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"/>
                            <TextBlock Text="倍速" FontSize="12"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                       Margin="6,0,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="UserBtn" Style="{StaticResource ToolBarButtonStyle}"
                            ToolTip="切换游戏账号"
                            MouseEnter="OnUserBtnMouseEnter"
                            MouseLeave="OnUserBtnMouseLeave">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Person20" FontSize="14"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"/>
                            <TextBlock Text="账号" FontSize="12"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                       Margin="6,0,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="FullscreenBtn" Style="{StaticResource ToolBarButtonStyle}"
                            ToolTip="全屏"
                            Click="OnToggleFullscreen">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="11" Height="11" Stretch="Uniform">
                                <Canvas Width="24" Height="24">
                                    <Path Data="M4,4 L10,4 L10,6 L6,6 L6,10 L4,10 Z M20,20 L14,20 L14,18 L18,18 L18,14 L20,14 Z M4,20 L4,14 L6,14 L6,18 L10,18 L10,20 Z M20,4 L14,4 L14,6 L18,6 L18,10 L20,10 Z"
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="全屏" FontSize="12"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                       Margin="6,0,0,0"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <!-- 内嵌游戏窗口区域（多账号会话各自一个 GameHostView，切换时控制可见性） -->
            <Border Background="#1E1E1E" ClipToBounds="True">
                <Grid>
                    <StackPanel x:Name="Placeholder" HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <TextBlock x:Name="PlaceholderText" Text="尚未启动游戏" FontSize="15" Foreground="#999"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="在「账号管理」页点击账号的开始游戏按钮即可添加标签" FontSize="12" Foreground="#777"
                                   HorizontalAlignment="Center" Margin="0,6,0,0"/>
                    </StackPanel>
                    <Grid x:Name="GameHostContainer"/>
                </Grid>
            </Border>
        </DockPanel>

        <!-- 用户图标 hover：游戏账号切换列表（放 Grid 重叠层，不参与 DockPanel 布局） -->
        <Popup x:Name="UserMenuPopup"
               PlacementTarget="{Binding ElementName=UserBtn}"
               Placement="Bottom" AllowsTransparency="True"
               StaysOpen="False" PopupAnimation="Fade"
               IsOpen="False">
            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="6"
                    Margin="0,4,0,0" MaxHeight="360"
                    MouseEnter="OnUserMenuPopupEnter"
                    MouseLeave="OnUserMenuPopupLeave">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="UserList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource UserItemButtonStyle}"
                                        Content="{Binding DisplayName}"
                                        Tag="{Binding}" Click="OnUserAccountClick"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </Popup>

        <!-- 倍速 hover 菜单 -->
        <Popup x:Name="SpeedMenuPopup"
               PlacementTarget="{Binding ElementName=SpeedBtn}"
               Placement="Bottom" AllowsTransparency="True"
               StaysOpen="False" PopupAnimation="Fade"
               IsOpen="False">
            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="8"
                    Margin="0,4,0,0" MinWidth="140"
                    MouseEnter="OnSpeedMenuPopupEnter"
                    MouseLeave="OnSpeedMenuPopupLeave">
                <StackPanel>
                    <TextBlock Text="倍速" FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Margin="4,0,0,6"/>
                    <RadioButton Content="0.5 倍速" GroupName="SpeedGroup" Tag="5"
                                 Margin="4,3" FontSize="13"
                                 Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                 Checked="OnSpeedChanged"/>
                    <RadioButton Content="1 倍速" GroupName="SpeedGroup" Tag="10" IsChecked="True"
                                 Margin="4,3" FontSize="13"
                                 Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                 Checked="OnSpeedChanged"/>
                    <RadioButton Content="2 倍速" GroupName="SpeedGroup" Tag="20"
                                 Margin="4,3" FontSize="13"
                                 Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                 Checked="OnSpeedChanged"/>
                    <RadioButton Content="4 倍速" GroupName="SpeedGroup" Tag="40"
                                 Margin="4,3" FontSize="13"
                                 Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                 Checked="OnSpeedChanged"/>
                    <StackPanel Orientation="Horizontal" Margin="4,3">
                        <RadioButton Content="自定义" GroupName="SpeedGroup" Tag="custom"
                                     FontSize="13" VerticalAlignment="Center"
                                     Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                     Checked="OnSpeedChanged"/>
                        <TextBox x:Name="CustomSpeedBox" Width="52" FontSize="12"
                                 VerticalContentAlignment="Center"
                                 Margin="6,0,0,0" Padding="4,2"
                                 ToolTip="输入倍速，如 1.5、3、10"
                                 KeyDown="OnCustomSpeedKeyDown"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</ui:FluentWindow>