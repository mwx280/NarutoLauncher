<UserControl x:Class="NarutoLauncher.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="40">
        <TextBlock Text="火影忍者Online 启动器" FontSize="28" FontWeight="Bold"
                   HorizontalAlignment="Center"/>
        <TextBlock Text="v1.0.3（开源版）" FontSize="16" Margin="0,12,0,0"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   HorizontalAlignment="Center"/>

        <Button x:Name="UpdateButton" Margin="0,24,0,0" Padding="20,8"
                HorizontalAlignment="Center"
                Click="OnCheckUpdate">
            <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Symbol="ArrowDownload20" FontSize="16"
                               VerticalAlignment="Center"/>
                <TextBlock Text="检查更新" Margin="8,0,0,0"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Button>
        <TextBlock x:Name="UpdateStatus" Text="" FontSize="14" Margin="0,10,0,0"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   HorizontalAlignment="Center"/>

        <TextBlock Text="开源项目，欢迎 Star / 提 Issue 参与改进。" FontSize="14"
                   Margin="0,32,0,0" HorizontalAlignment="Center"/>
        <Button Margin="0,12,0,0" Padding="16,6" HorizontalAlignment="Center"
                Content="打开开源仓库" Click="OnOpenRepo"/>
    </StackPanel>
</UserControl>
