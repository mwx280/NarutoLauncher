<ui:FluentWindow x:Class="NarutoLauncher.Views.AddAccountWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:views="clr-namespace:NarutoLauncher.Views"
                 Title="添加账号" Height="620" Width="420"
                 WindowStartupLocation="CenterOwner"
                 ResizeMode="NoResize"
                 Background="{DynamicResource WindowBackground}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 右上角提示（登录成功等） -->
        <Border x:Name="ToastBox" Panel.ZIndex="10" Visibility="Collapsed"
                Background="{DynamicResource AccentFillColorDefaultBrush}"
                CornerRadius="6" Padding="14,10"
                HorizontalAlignment="Right" VerticalAlignment="Top"
                Margin="0,4,0,0" MaxWidth="320">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="ToastIcon" Text="&#xE73E;" FontFamily="Segoe Fluent Icons"
                           FontSize="15" Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                           VerticalAlignment="Center"/>
                <TextBlock x:Name="ToastText" FontSize="13" Margin="8,0,0,0"
                           Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                           TextWrapping="Wrap" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- 选项卡：账号密码 / 扫码登录 -->
        <TabControl Grid.Row="0" x:Name="MainTabs">
            <!-- 账号密码 -->
            <TabItem Header="账号密码">
                <StackPanel Margin="4,16,4,4">
                    <TextBlock Text="QQ 号" FontSize="13"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,4"/>
                    <ui:TextBox x:Name="QqBox" Height="34" FontSize="14"/>
                    <TextBlock Text="密码" FontSize="13"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,16,0,4"/>
                    <ui:PasswordBox x:Name="PwdBox" Height="34" FontSize="14"/>
                    <CheckBox x:Name="RememberPwdBox" Content="记住密码（本地加密存储）"
                              Margin="0,12,0,0" FontSize="13" IsChecked="True"/>
                    <TextBlock Text="备注（可选）" FontSize="13"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,16,0,4"/>
                    <ui:TextBox x:Name="NameBox" Height="34" FontSize="14"/>
                    <TextBlock Text="添加后可点击账号「开始游戏」进入游戏，登录状态将自动保存"
                               FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" Margin="0,16,0,0"/>
                </StackPanel>
            </TabItem>

            <!-- 扫码登录 -->
            <TabItem Header="扫码登录">
                <StackPanel Margin="4,8,4,4">
                    <Border Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="8"
                            Height="240" HorizontalAlignment="Stretch"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                            BorderThickness="1" ClipToBounds="True">
                        <Grid>
                            <views:GameHostView x:Name="QrHost"/>
                            <StackPanel x:Name="QrPlaceholder" VerticalAlignment="Center"
                                        HorizontalAlignment="Center">
                                <ProgressBar Width="120" Height="4" IsIndeterminate="True"/>
                                <TextBlock Text="正在加载二维码..." FontSize="13"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           HorizontalAlignment="Center" Margin="0,12,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <TextBlock Text="使用手机 QQ 扫描二维码登录" FontSize="13"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                               HorizontalAlignment="Center" Margin="0,12,0,0"/>
                    <TextBlock Text="扫描登录成功后自动获取账号，直接添加即可"
                               FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" HorizontalAlignment="Center"
                               Margin="0,6,0,0"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
                        <ui:Button x:Name="RefreshQrBtn" Content="开始扫码登录" Width="140" Height="32"
                                   Margin="0,0,10,0"
                                   Appearance="Primary" Click="OnRefreshQr"/>
                        <ui:Button x:Name="CopyQrBtn" Content="复制二维码" Width="100" Height="32"
                                   IsEnabled="False" Appearance="Secondary"
                                   Click="OnCopyQr"/>
                    </StackPanel>
                    <TextBlock Text="备注（可选）" FontSize="13"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,14,0,4"/>
                    <ui:TextBox x:Name="ScanNameBox" Height="34" FontSize="14"/>
                </StackPanel>
            </TabItem>
        </TabControl>

        <!-- 底部按钮 -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <ui:Button Content="取消" Appearance="Secondary" Width="90" Height="34"
                       Margin="0,0,10,0" Click="OnCancel"/>
            <ui:Button x:Name="ConfirmBtn" Content="添加账号" Appearance="Primary"
                       Width="110" Height="34" Click="OnConfirm"/>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
