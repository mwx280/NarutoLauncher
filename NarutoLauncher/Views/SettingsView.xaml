<UserControl x:Class="NarutoLauncher.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <UserControl.Resources>
        <!-- Win11 设置项行：图标 + 名称/说明 + 开关 -->
        <Style x:Key="SettingRowStyle" TargetType="Border">
            <Setter Property="Padding" Value="20,14"/>
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Margin" Value="0,4"/>
        </Style>

        <!-- 设置项图标 -->
        <Style x:Key="SettingIconStyle" TargetType="Border">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Margin" Value="0,0,14,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- 设置项图标文字 -->
        <Style x:Key="SettingIconTextStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- 设置项名称文字 -->
        <Style x:Key="ItemNameStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
        </Style>

        <!-- 设置项说明文字 -->
        <Style x:Key="ItemDescStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>

        <!-- 分组标题 -->
        <Style x:Key="GroupTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
            <Setter Property="Margin" Value="4,10,0,4"/>
        </Style>

        <!-- 页面大标题 -->
        <Style x:Key="PageTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <!-- 主题单选按钮 -->
        <Style x:Key="ThemeRadioStyle" TargetType="RadioButton">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
            <Setter Property="Margin" Value="0,6,24,6"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer>
        <StackPanel Margin="28,20,28,24">

            <TextBlock Text="设置" Style="{StaticResource PageTitleStyle}"/>

            <!-- ===== 个性化分组 ===== -->
            <TextBlock Text="个性化" Style="{StaticResource GroupTitleStyle}"/>

            <!-- 深色模式 -->
            <Border Style="{StaticResource SettingRowStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource SettingIconStyle}">
                        <TextBlock Text="&#xE706;" Style="{StaticResource SettingIconTextStyle}"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="深色模式" Style="{StaticResource ItemNameStyle}"/>
                        <TextBlock Text="选择应用的外观模式" Style="{StaticResource ItemDescStyle}"/>
                    </StackPanel>
                    <ComboBox x:Name="ThemeCombo" Grid.Column="2" Margin="0,0,20,0"
                              Width="120" Height="34" Padding="10,0"
                              VerticalContentAlignment="Center"
                              Background="{DynamicResource ControlFillColorDefaultBrush}"
                              BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                              BorderThickness="1" FontSize="13"
                              SelectionChanged="OnThemeChanged">
                        <ComboBoxItem Content="跟随系统"/>
                        <ComboBoxItem Content="深色"/>
                        <ComboBoxItem Content="浅色"/>
                    </ComboBox>
                </Grid>
            </Border>

            <!-- 主题色 -->
            <Border Style="{StaticResource SettingRowStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource SettingIconStyle}">
                        <TextBlock Text="&#xE790;" Style="{StaticResource SettingIconTextStyle}"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="主题色" Style="{StaticResource ItemNameStyle}"/>
                        <TextBlock Text="选择强调色（按钮/开关/选中状态）" Style="{StaticResource ItemDescStyle}"/>
                        <!-- 色板（自定义模式下可见） -->
                        <StackPanel x:Name="ColorPalette" Orientation="Horizontal" Margin="0,6,0,0" Visibility="Collapsed">
                            <Border x:Name="ColorChip0" Width="22" Height="22" CornerRadius="4"
                                    Background="#E8482C" Margin="0,0,6,0" Cursor="Hand"
                                    MouseLeftButtonUp="OnColorClick" Tag="#E8482C"/>
                            <Border x:Name="ColorChip1" Width="22" Height="22" CornerRadius="4"
                                    Background="#0078D4" Margin="0,0,6,0" Cursor="Hand"
                                    MouseLeftButtonUp="OnColorClick" Tag="#0078D4"/>
                            <Border x:Name="ColorChip2" Width="22" Height="22" CornerRadius="4"
                                    Background="#107C10" Margin="0,0,6,0" Cursor="Hand"
                                    MouseLeftButtonUp="OnColorClick" Tag="#107C10"/>
                            <Border x:Name="ColorChip3" Width="22" Height="22" CornerRadius="4"
                                    Background="#8764B8" Margin="0,0,6,0" Cursor="Hand"
                                    MouseLeftButtonUp="OnColorClick" Tag="#8764B8"/>
                            <Border x:Name="ColorChip4" Width="22" Height="22" CornerRadius="4"
                                    Background="#FFB900" Margin="0,0,6,0" Cursor="Hand"
                                    MouseLeftButtonUp="OnColorClick" Tag="#FFB900"/>
                            <Border x:Name="ColorChip5" Width="22" Height="22" CornerRadius="4"
                                    Background="#00B7C3" Margin="0,0,6,0" Cursor="Hand"
                                    MouseLeftButtonUp="OnColorClick" Tag="#00B7C3"/>
                        </StackPanel>
                    </StackPanel>
                    <ComboBox x:Name="AccentCombo" Grid.Column="2" Margin="0,0,20,0"
                              Width="120" Height="34" Padding="10,0"
                              VerticalContentAlignment="Center"
                              Background="{DynamicResource ControlFillColorDefaultBrush}"
                              BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                              BorderThickness="1" FontSize="13"
                              SelectionChanged="OnAccentChanged">
                        <ComboBoxItem Content="跟随系统"/>
                        <ComboBoxItem Content="自定义"/>
                    </ComboBox>
                </Grid>
            </Border>

            <!-- 导航风格 -->
            <Border Style="{StaticResource SettingRowStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource SettingIconStyle}">
                        <TextBlock Text="&#xE700;" Style="{StaticResource SettingIconTextStyle}"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="导航风格" Style="{StaticResource ItemNameStyle}"/>
                        <TextBlock Text="经典：宽侧栏文字导航  |  简约：窄侧栏图标导航" Style="{StaticResource ItemDescStyle}"/>
                    </StackPanel>
                    <ComboBox x:Name="NavStyleCombo" Grid.Column="2" Margin="0,0,20,0"
                              Width="120" Height="34" Padding="10,0"
                              VerticalContentAlignment="Center"
                              Background="{DynamicResource ControlFillColorDefaultBrush}"
                              BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                              BorderThickness="1" FontSize="13"
                              SelectionChanged="OnNavStyleChanged">
                        <ComboBoxItem Content="经典"/>
                        <ComboBoxItem Content="简约"/>
                    </ComboBox>
                </Grid>
            </Border>

            <!-- ===== 游戏分组 ===== -->
            <TextBlock Text="游戏" Style="{StaticResource GroupTitleStyle}"/>

            <!-- 游戏变速 -->
            <Border Style="{StaticResource SettingRowStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource SettingIconStyle}">
                        <TextBlock Text="&#xE94A;" Style="{StaticResource SettingIconTextStyle}"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="游戏变速" Style="{StaticResource ItemNameStyle}"/>
                        <TextBlock Text="调整游戏运行速度" Style="{StaticResource ItemDescStyle}"/>
                    </StackPanel>
                    <ui:ToggleSwitch Grid.Column="2" x:Name="GameSpeedBox"/>
                </Grid>
            </Border>

            <!-- 挂机防掉线 -->
            <Border Style="{StaticResource SettingRowStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource SettingIconStyle}">
                        <TextBlock Text="&#xEA18;" Style="{StaticResource SettingIconTextStyle}"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="挂机防掉线" Style="{StaticResource ItemNameStyle}"/>
                        <TextBlock Text="挂机时自动重连，防止掉线" Style="{StaticResource ItemDescStyle}"/>
                    </StackPanel>
                    <ui:ToggleSwitch Grid.Column="2" x:Name="AntiDropBox"/>
                </Grid>
            </Border>

            <!-- ===== 画质分组 ===== -->
            <TextBlock Text="画质" Style="{StaticResource GroupTitleStyle}"/>

            <!-- Flash 硬件加速 -->
            <Border Style="{StaticResource SettingRowStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource SettingIconStyle}">
                        <TextBlock Text="&#xE94A;" Style="{StaticResource SettingIconTextStyle}"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Flash 硬件加速" Style="{StaticResource ItemNameStyle}"/>
                        <TextBlock Text="GPU 合成提升流畅度（默认开启，实测优于纯 CPU 合成）" Style="{StaticResource ItemDescStyle}"/>
                    </StackPanel>
                    <ui:ToggleSwitch Grid.Column="2" x:Name="FlashGpuBox"/>
                </Grid>
            </Border>

            <!-- 分辨率模式 -->
            <Border Style="{StaticResource SettingRowStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource SettingIconStyle}">
                        <TextBlock Text="&#xE740;" Style="{StaticResource SettingIconTextStyle}"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="分辨率模式" Style="{StaticResource ItemNameStyle}"/>
                        <TextBlock Text="性能优先：画质降级明显，流畅度高 | 画质优先：画面清晰，大屏体验好" Style="{StaticResource ItemDescStyle}"/>
                    </StackPanel>
                    <ComboBox x:Name="DprModeCombo" Grid.Column="2" Margin="0,0,20,0"
                              Width="120" Height="34" Padding="10,0"
                              VerticalContentAlignment="Center"
                              Background="{DynamicResource ControlFillColorDefaultBrush}"
                              BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                              BorderThickness="1" FontSize="13"
                              SelectionChanged="OnDprModeChanged">
                        <ComboBoxItem Content="性能优先"/>
                        <ComboBoxItem Content="画质优先"/>
                    </ComboBox>
                </Grid>
            </Border>

            <!-- 全局画质调节 -->
            <Border Style="{StaticResource SettingRowStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource SettingIconStyle}">
                        <TextBlock Text="&#xE7C8;" Style="{StaticResource SettingIconTextStyle}"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="全局画质调节" Style="{StaticResource ItemNameStyle}"/>
                        <TextBlock Text="低/中/高三档，需重新进入游戏生效" Style="{StaticResource ItemDescStyle}"/>
                    </StackPanel>
                    <ComboBox x:Name="FlashQualityCombo" Grid.Column="2" Margin="0,0,20,0"
                              Width="120" Height="34" Padding="10,0"
                              VerticalContentAlignment="Center"
                              Background="{DynamicResource ControlFillColorDefaultBrush}"
                              BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                              BorderThickness="1" FontSize="13"
                              SelectionChanged="OnFlashQualityChanged">
                        <ComboBoxItem Content="低"/>
                        <ComboBoxItem Content="中"/>
                        <ComboBoxItem Content="高"/>
                    </ComboBox>
                </Grid>
            </Border>

            <!-- ===== 自动化分组 ===== -->
            <TextBlock Text="自动化" Style="{StaticResource GroupTitleStyle}"/>

            <!-- 自动脚本 -->
            <Border Style="{StaticResource SettingRowStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource SettingIconStyle}">
                        <TextBlock Text="&#xE713;" Style="{StaticResource SettingIconTextStyle}"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="自动脚本" Style="{StaticResource ItemNameStyle}"/>
                        <TextBlock Text="自动执行预设脚本任务" Style="{StaticResource ItemDescStyle}"/>
                    </StackPanel>
                    <ui:ToggleSwitch Grid.Column="2" x:Name="AutoScriptBox"/>
                </Grid>
            </Border>

            <!-- 自动任务 -->
            <Border Style="{StaticResource SettingRowStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource SettingIconStyle}">
                        <TextBlock Text="&#xE9D5;" Style="{StaticResource SettingIconTextStyle}"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="自动任务" Style="{StaticResource ItemNameStyle}"/>
                        <TextBlock Text="自动完成日常任务" Style="{StaticResource ItemDescStyle}"/>
                    </StackPanel>
                    <ui:ToggleSwitch Grid.Column="2" x:Name="AutoTaskBox"/>
                </Grid>
            </Border>

            <!-- ===== 界面分组 ===== -->
            <TextBlock Text="界面" Style="{StaticResource GroupTitleStyle}"/>

            <!-- 最小化到托盘 -->
            <Border Style="{StaticResource SettingRowStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource SettingIconStyle}">
                        <TextBlock Text="&#xE7F4;" Style="{StaticResource SettingIconTextStyle}"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="最小化到托盘" Style="{StaticResource ItemNameStyle}"/>
                        <TextBlock Text="关闭窗口时最小化到系统托盘" Style="{StaticResource ItemDescStyle}"/>
                    </StackPanel>
                    <ui:ToggleSwitch Grid.Column="2" x:Name="TrayBox"/>
                </Grid>
            </Border>

            <!-- ===== 账号与安全分组 ===== -->
            <TextBlock Text="账号与安全" Style="{StaticResource GroupTitleStyle}"/>

            <!-- 记住密码 -->
            <Border Style="{StaticResource SettingRowStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource SettingIconStyle}">
                        <TextBlock Text="&#xE72E;" Style="{StaticResource SettingIconTextStyle}"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="记住密码" Style="{StaticResource ItemNameStyle}"/>
                        <TextBlock Text="本地 DPAPI 加密存储，安全保存账号密码" Style="{StaticResource ItemDescStyle}"/>
                    </StackPanel>
                    <ui:ToggleSwitch Grid.Column="2" x:Name="RememberPwdBox"/>
                </Grid>
            </Border>

            <!-- ===== 关于分组 ===== -->
            <TextBlock Text="关于" Style="{StaticResource GroupTitleStyle}"/>

            <!-- 关于 -->
            <Border Style="{StaticResource SettingRowStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource SettingIconStyle}">
                        <TextBlock Text="&#xE946;" Style="{StaticResource SettingIconTextStyle}"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="NarutoLauncher" Style="{StaticResource ItemNameStyle}"/>
                        <TextBlock Text="v0.1.0 · 火影忍者OL 多账号多开启动器"
                                   Style="{StaticResource ItemDescStyle}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
