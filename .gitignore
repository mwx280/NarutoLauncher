# 构建产物
build/
publish/
*.exe
*.dll
*.lib
*.obj
*.o
*.exp
*.pdb
*.ilk
*.user
*.suo
.vs/
.idea/
.vscode/

# 第三方预编译依赖（由 tools/download_deps.ps1 下载，禁止入库）
third_party/*
!third_party/README.md

# Flash 插件（特殊优化版，随仓库分发，必须入库）
!third_party/pepflashplayer.dll
!third_party/pepflashplayer_x64.dll

# MinHook（x86/x64 hook 库，随仓库分发，必须入库）
!third_party/minhook/
!third_party/minhook/include/
!third_party/minhook/include/MinHook.h
!third_party/minhook/lib/
!third_party/minhook/lib/MinHook.x64.dll
!third_party/minhook/lib/MinHook.x64.lib
!third_party/minhook/lib/MinHook.x86.dll
!third_party/minhook/lib/MinHook.x86.lib

# UI 预览（非 Git 跟踪）
preview/

# SWF 反编译工具（本地分析用，禁止入库）
tools/ffdec/
tools/ffdec_out/

# 日志与临时文件
*.log
*.tmp
*.bak

# macOS AppleDouble 资源文件（从 macOS 复制产生）
._*

# 敏感信息（如未来出现，一律不入库）
.env
*.pem
*.key
secrets.*
credentials.*

# .NET / WPF 构建产物
bin/
obj/
*.suo
