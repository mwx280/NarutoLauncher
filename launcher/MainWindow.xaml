<Window
    x:Class="NarutoLauncher.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="火影忍者OL 启动器">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Grid Grid.Row="0" Height="48" Background="Transparent"
              VerticalAlignment="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="火影忍者OL"
                       FontSize="16" FontWeight="SemiBold"
                       VerticalAlignment="Center" Margin="16,0,0,0"/>
            <TextBlock Grid.Column="1" Text="启动器"
                       Foreground="#888888" FontSize="12"
                       VerticalAlignment="Center" Margin="4,0,0,0"/>
        </Grid>

        <!-- 主内容 -->
        <Grid Grid.Row="1">
            <TextBlock Text="启动器开发中..." HorizontalAlignment="Center"
                       VerticalAlignment="Center" FontSize="18"/>
        </Grid>
    </Grid>
</Window>
