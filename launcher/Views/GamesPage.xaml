<Page
    x:Class="NarutoLauncher.Views.GamesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="16">

            <TextBlock Text="游戏" Style="{StaticResource TitleTextBlockStyle}"/>

            <!-- 游戏入口 -->
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Padding="16" CornerRadius="8"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                    <StackPanel Spacing="8">
                        <TextBlock Text="开始游戏" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                        <TextBlock Text="启动选中账号的游戏窗口"
                                   Style="{StaticResource CaptionTextBlockStyle}"/>
                        <Button Content="开始游戏" Style="{StaticResource AccentButtonStyle}"
                                HorizontalAlignment="Left"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Padding="16" CornerRadius="8"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                    <StackPanel Spacing="8">
                        <TextBlock Text="全部启动" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                        <TextBlock Text="多开所有账号的游戏窗口"
                                   Style="{StaticResource CaptionTextBlockStyle}"/>
                        <Button Content="全部启动" HorizontalAlignment="Left"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Padding="16" CornerRadius="8"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                    <StackPanel Spacing="8">
                        <TextBlock Text="游戏状态" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                        <TextBlock Text="{x:Bind RunningCountText}"
                                   Style="{StaticResource CaptionTextBlockStyle}"/>
                        <Button Content="刷新状态" HorizontalAlignment="Left"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 服务器列表 -->
            <TextBlock Text="区服列表" Style="{StaticResource SubtitleTextBlockStyle}"/>
            <ListView ItemsSource="{x:Bind ViewModel.Servers}" SelectionMode="Single">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid ColumnSpacing="12" Padding="4,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="{Binding Name}"
                                           Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                <TextBlock Text="{Binding Region}"
                                           Style="{StaticResource CaptionTextBlockStyle}"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding Status}"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>
    </ScrollViewer>
</Page>
