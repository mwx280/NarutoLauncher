<Page
    x:Class="NarutoLauncher.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="20" MaxWidth="720" HorizontalAlignment="Left">

            <TextBlock Text="设置" Style="{StaticResource TitleTextBlockStyle}"/>

            <!-- 游戏 -->
            <TextBlock Text="游戏" Style="{StaticResource SubtitleTextBlockStyle}"/>
            <Border Padding="16" CornerRadius="8"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <StackPanel Spacing="12">
                    <ToggleSwitch Header="游戏变速"
                                  IsOn="{x:Bind ViewModel.Settings.GameSpeed, Mode=TwoWay}"/>
                    <ToggleSwitch Header="挂机防掉线"
                                  IsOn="{x:Bind ViewModel.Settings.AntiDrop, Mode=TwoWay}"/>
                </StackPanel>
            </Border>

            <!-- 自动化 -->
            <TextBlock Text="自动化" Style="{StaticResource SubtitleTextBlockStyle}"/>
            <Border Padding="16" CornerRadius="8"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <StackPanel Spacing="12">
                    <ToggleSwitch Header="自动脚本"
                                  IsOn="{x:Bind ViewModel.Settings.AutoScript, Mode=TwoWay}"/>
                    <ToggleSwitch Header="自动任务"
                                  IsOn="{x:Bind ViewModel.Settings.AutoTask, Mode=TwoWay}"/>
                    <TextBlock Text="自动功能通过页面级 JS + ExternalInterface 实现，需账号已登录。"
                               Style="{StaticResource CaptionTextBlockStyle}"/>
                </StackPanel>
            </Border>

            <!-- 界面 -->
            <TextBlock Text="界面" Style="{StaticResource SubtitleTextBlockStyle}"/>
            <Border Padding="16" CornerRadius="8"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <StackPanel Spacing="12">
                    <ToggleSwitch Header="深色主题"
                                  IsOn="{x:Bind ViewModel.Settings.DarkTheme, Mode=TwoWay}"/>
                    <ToggleSwitch Header="最小化到托盘"
                                  IsOn="{x:Bind ViewModel.Settings.MinimizeToTray, Mode=TwoWay}"/>
                </StackPanel>
            </Border>

            <!-- 账号与安全 -->
            <TextBlock Text="账号与安全" Style="{StaticResource SubtitleTextBlockStyle}"/>
            <Border Padding="16" CornerRadius="8"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <StackPanel Spacing="12">
                    <ToggleSwitch Header="记住密码（本地 DPAPI 加密存储）"
                                  IsOn="{x:Bind ViewModel.Settings.RememberPassword, Mode=TwoWay}"/>
                </StackPanel>
            </Border>

            <!-- 关于 -->
            <TextBlock Text="关于" Style="{StaticResource SubtitleTextBlockStyle}"/>
            <Border Padding="16" CornerRadius="8"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <StackPanel Spacing="4">
                    <TextBlock Text="NarutoLauncher v0.1.0"
                               Style="{StaticResource BodyStrongTextBlockStyle}"/>
                    <TextBlock Text="火影忍者OL 启动器 · 多账号多开 · 基于 WinUI 3"
                               Style="{StaticResource CaptionTextBlockStyle}"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
