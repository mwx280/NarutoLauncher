<Page
    x:Class="NarutoLauncher.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:NarutoLauncher.Models"
    mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="20">

            <!-- 欢迎横幅 -->
            <StackPanel Spacing="4">
                <TextBlock Text="火影忍者OL" Style="{StaticResource TitleTextBlockStyle}"/>
                <TextBlock Text="忍界大战 · 多开登录 · 一键加速 · 自动挂机"
                           Style="{StaticResource CaptionTextBlockStyle}"/>
            </StackPanel>

            <Button Content="开始游戏" Style="{StaticResource AccentButtonStyle}"
                    HorizontalAlignment="Left" MinWidth="160"
                    Click="OnStartGame"/>

            <!-- 账号区 -->
            <TextBlock Text="我的账号" Style="{StaticResource SubtitleTextBlockStyle}"/>
            <GridView ItemsSource="{x:Bind ViewModel.Accounts}"
                      SelectionMode="None" IsItemClickEnabled="True"
                      ItemClick="OnAccountClick">
                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="models:Account">
                        <StackPanel Width="220" Padding="16" Spacing="6"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="8">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Border Width="42" Height="42" CornerRadius="21"
                                        Background="{ThemeResource AccentFillColorDefaultBrush}">
                                    <TextBlock Text="{x:Bind AvatarChar}" FontSize="18"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Foreground="White"/>
                                </Border>
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind DisplayName}"
                                               Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                    <TextBlock Text="{x:Bind InfoText}"
                                               Style="{StaticResource CaptionTextBlockStyle}"/>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8"
                                        HorizontalAlignment="Right">
                                <Button Content="{x:Bind RunText}" Click="OnToggleRun"
                                        Tag="{x:Bind Id}" FontSize="12" Padding="10,4"/>
                            </StackPanel>
                        </StackPanel>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>

            <!-- 功能设置 -->
            <TextBlock Text="功能设置" Style="{StaticResource SubtitleTextBlockStyle}"/>
            <Grid ColumnSpacing="16" RowSpacing="16">
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <ToggleSwitch Header="游戏变速" Grid.Row="0" Grid.Column="0"
                              IsOn="{x:Bind ViewModel.Settings.GameSpeed, Mode=TwoWay}"/>
                <ToggleSwitch Header="挂机防掉线" Grid.Row="0" Grid.Column="1"
                              IsOn="{x:Bind ViewModel.Settings.AntiDrop, Mode=TwoWay}"/>
                <ToggleSwitch Header="自动脚本" Grid.Row="0" Grid.Column="2"
                              IsOn="{x:Bind ViewModel.Settings.AutoScript, Mode=TwoWay}"/>
                <ToggleSwitch Header="自动任务" Grid.Row="1" Grid.Column="0"
                              IsOn="{x:Bind ViewModel.Settings.AutoTask, Mode=TwoWay}"/>
                <ToggleSwitch Header="深色主题" Grid.Row="1" Grid.Column="1"
                              IsOn="{x:Bind ViewModel.Settings.DarkTheme, Mode=TwoWay}"/>
                <ToggleSwitch Header="最小化到托盘" Grid.Row="1" Grid.Column="2"
                              IsOn="{x:Bind ViewModel.Settings.MinimizeToTray, Mode=TwoWay}"/>
            </Grid>

            <InfoBar x:Name="TipInfoBar" IsClosable="True" IsOpen="False"/>
        </StackPanel>
    </ScrollViewer>
</Page>
