<Application
    x:Class="NarutoLauncher.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:NarutoLauncher.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary Source="Themes/HyTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <converters:RunBgConverter x:Key="RunBgConverter"/>
            <converters:RunFgConverter x:Key="RunFgConverter"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
