<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 火影主题色 -->
    <Color x:Key="HyPrimary">#E8482C</Color>
    <Color x:Key="HyPrimaryBright">#FF6A3D</Color>
    <Color x:Key="HyPrimaryDark">#A62B1C</Color>
    <Color x:Key="HyBg">#0D0F14</Color>
    <Color x:Key="HyBgElevated">#181B24</Color>
    <Color x:Key="HyBorder">#2A3040</Color>
    <Color x:Key="HyText">#FFFFFF</Color>
    <Color x:Key="HyTextSub">#8A91A5</Color>

    <!-- 账号头像渐变 -->
    <LinearGradientBrush x:Key="HyAvatarBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF6A3D" Offset="0"/>
        <GradientStop Color="#A62B1C" Offset="1"/>
    </LinearGradientBrush>

    <!-- 卡片样式 -->
    <Style x:Key="HyCardStyle" TargetType="Border">
        <Setter Property="Background" Value="#181B24"/>
        <Setter Property="CornerRadius" Value="14"/>
        <Setter Property="BorderBrush" Value="#2A3040"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <!-- 切换开关 -->
    <Style x:Key="HyToggleSwitchStyle" TargetType="ToggleSwitch">
        <Setter Property="OnContent" Value=""/>
        <Setter Property="OffContent" Value=""/>
    </Style>

</ResourceDictionary>
